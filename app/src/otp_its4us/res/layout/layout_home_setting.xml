<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:background="@color/colorHalfTransparent"
    >

    <ImageView
        android:id="@+id/iv_close_home_setting"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="@dimen/margin_large"
        android:layout_marginTop="@dimen/margin_large"
        android:layout_marginEnd="@dimen/margin_large"
        android:layout_marginBottom="@dimen/margin_large"
        android:contentDescription="@string/close_setting"
        android:src="@drawable/ic_close" />



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:background="@drawable/white_bg"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginBottom="@dimen/margin_medium"
            android:gravity="center"
            android:text="@string/search_mode_title"
            android:textColor="@color/colorBlack"
            android:textSize="@dimen/title_text_size_sp"
            android:textStyle="bold" />




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_large"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:layout_marginStart="@dimen/margin_large"
                    android:layout_marginEnd="@dimen/margin_large"
                    >

                    <LinearLayout
                        android:id="@+id/ll_home_setting_bus"
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_marginStart="17dp"
                        android:gravity="center"
                        android:padding="@dimen/padding_medium"
                        android:orientation="vertical"
                        >

                        <ImageView
                            android:id="@+id/iv_home_setting_bus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:src="@drawable/ic_bus"
                            />

                        <TextView
                            android:id="@+id/tv_home_setting_bus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="22dp"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center"
                            android:text="@string/bus"
                            android:textSize="@dimen/tiny_text_size_sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@android:color/black"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        />
                    <LinearLayout
                        android:id="@+id/ll_home_setting_marta_rail"
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:gravity="center"
                        android:padding="@dimen/padding_medium"
                        android:orientation="vertical"
                        >
                        <ImageView
                            android:id="@+id/iv_home_setting_marta_rail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:src="@drawable/ic_rail"
                            />

                        <TextView
                            android:id="@+id/tv_home_setting_marta_rail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="22dp"
                            android:text="@string/marta_rail"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textSize="@dimen/tiny_text_size_sp"
                            android:textColor="@android:color/black"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        />
                    <LinearLayout
                        android:id="@+id/ll_home_setting_atl_street_car"
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:gravity="center"
                        android:padding="@dimen/padding_medium"
                        android:orientation="vertical"
                        >
                        <ImageView
                            android:id="@+id/iv_home_setting_atl_street_car"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:src="@drawable/ic_streetcar"
                            />

                        <TextView
                            android:id="@+id/tv_home_setting_atl_street_car"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="22dp"
                            android:text="@string/atl_street_car"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textSize="@dimen/tiny_text_size_sp"
                            android:textColor="@android:color/black"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:visibility="gone"
                        />

                    <LinearLayout
                        android:id="@+id/ll_home_setting_gondola"
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:gravity="center"
                        android:paddingTop="@dimen/padding_small"
                        android:orientation="vertical"
                        android:visibility="gone"
                        >
                        <ImageView
                            android:id="@+id/iv_home_setting_gondola"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:src="@drawable/ic_gondola"
                            />

                        <TextView
                            android:id="@+id/tv_home_setting_gondola"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center"
                            android:text="@string/mode_gondola"
                            android:textSize="@dimen/tiny_text_size"
                            android:textColor="@android:color/black"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:visibility="gone"
                        />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:layout_marginStart="@dimen/margin_large"
                    android:layout_marginEnd="@dimen/margin_large"
                    >
                    <LinearLayout
                        android:id="@+id/ll_home_setting_link"
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_marginStart="17dp"
                        android:gravity="center"
                        android:paddingTop="@dimen/padding_small"
                        android:orientation="vertical"
                        android:visibility="gone"
                        >

                        <ImageView
                            android:id="@+id/iv_home_setting_link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:src="@drawable/ic_mode_link"
                            />

                        <TextView
                            android:id="@+id/tv_home_setting_link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="22dp"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center"
                            android:text="@string/link"
                            android:textSize="@dimen/tiny_text_size_sp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textColor="@android:color/black"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:visibility="gone"
                        />

                    <LinearLayout
                        android:id="@+id/ll_home_setting_ferry"
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:gravity="center"
                        android:paddingTop="@dimen/padding_small"
                        android:orientation="vertical"
                        android:visibility="gone"
                        >
                        <ImageView
                            android:id="@+id/iv_home_setting_ferry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:src="@drawable/ic_ferry"
                            />

                        <TextView
                            android:id="@+id/tv_home_setting_ferry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="22dp"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center"
                            android:text="@string/ferry"
                            android:textSize="@dimen/tiny_text_size_sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@android:color/black"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:visibility="gone"
                        />

                    <LinearLayout
                        android:id="@+id/ll_home_setting_water_taxi"
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:gravity="center"
                        android:paddingTop="@dimen/padding_small"
                        android:orientation="vertical"
                        android:visibility="gone"
                        >
                        <ImageView
                            android:id="@+id/iv_home_setting_water_taxi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:src="@drawable/ic_mode_water_taxi"
                            />

                        <TextView
                            android:id="@+id/tv_home_setting_water_taxi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="22dp"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center"
                            android:text="@string/water_taxi"
                            android:textSize="@dimen/tiny_text_size_sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@android:color/black"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:visibility="gone"
                        />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_large"
                    android:layout_marginEnd="@dimen/margin_large"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/ll_home_setting_monorail"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="17dp"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/padding_small">

                        <ImageView
                            android:id="@+id/iv_home_setting_monorail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:src="@drawable/ic_mode_monorail" />

                        <TextView
                            android:id="@+id/tv_home_setting_monorail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="2"
                            android:minHeight="22dp"
                            android:text="@string/monorail"
                            android:textColor="@android:color/black"
                            android:textSize="@dimen/tiny_text_size_sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                </LinearLayout>
            </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:layout_marginEnd="@dimen/margin_large"
            android:orientation="horizontal"
            android:visibility="gone"
            >
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/maximum_walk"
                android:textSize="@dimen/content_text_size_sp"
                android:textColor="@android:color/black"
                android:textStyle="bold"/>

            <Spinner
                android:id="@+id/sp_maximum_walk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_gravity="center_vertical"
                android:background="@null"
                android:entries="@array/maximum_walk_arrays"

                />
            <ImageView
                android:layout_width="@dimen/small_icon_size"
                android:layout_height="@dimen/small_icon_size"
                android:src="@drawable/ic_downarrow"
                android:layout_gravity="center_vertical"
                app:tint="@android:color/black" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:layout_marginEnd="@dimen/margin_large"
            android:orientation="horizontal"
            android:visibility="gone"
            >
            <TextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/optimize_for"
                android:textSize="@dimen/content_text_size_sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"


                android:textColor="@android:color/black"/>

            <Spinner
                android:id="@+id/sp_optimize_option"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_gravity="center_vertical"
                android:background="@null"
                android:entries="@array/optimize_option_arrays"
                android:layout_marginEnd="5dp"





                />
            <ImageView
                android:layout_width="@dimen/small_icon_size"
                android:layout_height="@dimen/small_icon_size"
                android:src="@drawable/ic_downarrow"
                android:layout_gravity="center_vertical"
                app:tint="@android:color/black"
                />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/margin_medium"
            android:visibility="gone"
            >
            <TextView
                android:id="@+id/tv_forgot_my_options"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/aoda_height"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:text="@string/forgot_my_options"
                android:textSize="@dimen/content_text_size"
                android:textColor="@color/colorPrimary"/>

            <TextView
                android:id="@+id/tv_restore_my_defaults"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/aoda_height"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:text="@string/restore_my_defaults"
                android:textSize="@dimen/content_text_size"
                android:textColor="@color/colorPrimary"/>
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_home_setting_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/aoda_height"
            android:minWidth="@dimen/aoda_width"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:layout_marginBottom="@dimen/margin_small"
            android:text="@string/ok"
            android:textSize="@dimen/content_text_size_sp"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_large"
        android:layout_marginEnd="@dimen/margin_large"
        android:layout_marginTop="@dimen/margin_large"
        android:layout_marginBottom="@dimen/margin_small"
        android:orientation="horizontal"
        android:visibility="gone"
        >

        <ImageView
            android:id="@+id/iv_avoid_walking"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_layer_toggle_on"
            android:layout_marginStart="17dp"/>


        <TextView
            android:id="@+id/tv_avoid_walking"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_weight="1"
            android:gravity="start"
            android:text="@string/avoid_walking"
            android:textColor="@android:color/black"
            android:textSize="@dimen/content_text_size_sp" />




    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:layout_marginEnd="@dimen/margin_large"
            android:layout_marginBottom="@dimen/margin_small"
            android:orientation="horizontal"
            android:visibility="gone"
            >

            <ImageView
                android:id="@+id/iv_accessible_routing"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_layer_toggle_on"
                android:layout_marginStart="17dp"/>


            <TextView
                android:id="@+id/tv_accessible_routing"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/margin_medium"
                android:gravity="start"
                android:text="@string/accessible_routing"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp" />



        </LinearLayout>



        <LinearLayout
            android:id="@+id/ll_allow_bike_rental"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:layout_marginEnd="@dimen/margin_large"
            android:layout_marginBottom="@dimen/margin_small"

            android:orientation="horizontal"
            android:visibility="visible"
            >

            <ImageView
                android:id="@+id/iv_allow_bike_rental"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_layer_toggle_on"
                android:layout_marginStart="17dp"/>


            <TextView
                android:id="@+id/tv_allow_bike_rental"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/margin_medium"
                android:gravity="start"
                android:text="@string/allow_bike_rental"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_allow_scooter_rental"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:layout_marginEnd="@dimen/margin_large"
            android:layout_marginBottom="@dimen/margin_small"

            android:orientation="horizontal"
            android:visibility="visible"
            >

            <ImageView
                android:id="@+id/iv_allow_scooter_rental"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_layer_toggle_on"
                android:layout_marginStart="17dp"/>


            <TextView
                android:id="@+id/tv_allow_scooter_rental"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/margin_medium"
                android:gravity="start"
                android:text="@string/allow_scooter_rental"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:layout_marginEnd="@dimen/margin_large"

            android:layout_marginBottom="@dimen/margin_large"
            android:orientation="horizontal"
            android:visibility="gone"
            >
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:layout_gravity="center_vertical"
                android:text="@string/walk_speed_no_caps"
                android:textSize="@dimen/content_text_size_sp"
                android:textColor="@android:color/black"/>

            <Spinner
                android:id="@+id/sp_walk_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_gravity="center_vertical"
                android:background="@null"
                android:entries="@array/walk_speed_arrays_otp"

                />
            <ImageView
                android:layout_width="@dimen/small_icon_size"
                android:layout_height="@dimen/small_icon_size"
                android:src="@drawable/ic_downarrow"
                android:layout_gravity="center_vertical"
                app:tint="@android:color/black" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_mobility_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginStart="@dimen/margin_medium"
                android:text="@string/mobility_profile"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/title_text_size_sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/travel_companion_mobility_profile_hint"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/content_text_size_sp"
                 />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginBottom="@dimen/margin_medium"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:text="@string/use_mobility_profile"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/content_text_size_sp"
                    />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_primary_frame_bg"
                    android:paddingEnd="@dimen/padding_small"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:orientation="horizontal">
                    <Spinner
                        android:id="@+id/sp_mobility_profile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        android:background="@null"
                        />
                    <ImageView
                        android:layout_width="@dimen/small_icon_size"
                        android:layout_height="@dimen/small_icon_size"
                        android:src="@drawable/ic_downarrow"
                        android:layout_gravity="center_vertical"
                        app:tint="@color/colorPrimary" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
