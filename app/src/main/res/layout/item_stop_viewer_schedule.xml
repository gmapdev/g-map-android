<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="false"
    android:importantForAccessibility="yes"
    >


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_marginBottom="@dimen/margin_small"
        android:orientation="horizontal"
        >

        <com.android.volley.toolbox.NetworkImageView
            android:id="@+id/iv_schedule_logo"
            android:layout_width="@dimen/stop_viewer_schedule_route_name_width"
            android:layout_height="@dimen/stop_viewer_schedule_route_name_width"
            android:layout_marginStart="10dp"
            android:padding="@dimen/padding_medium"
            android:visibility="gone"
            android:layout_gravity="center_vertical"
            />

        <TextView
            android:id="@+id/tv_schedule_route"
            android:layout_width="@dimen/stop_viewer_schedule_route_name_width"
            android:layout_height="match_parent"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:textSize="@dimen/layer_text_size_sp"
            />
        <TextView
            android:id="@+id/tv_schedule_to"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:textSize="@dimen/layer_text_size_sp"
            android:paddingEnd = "@dimen/padding_small"
            />
        <TextView
            android:id="@+id/tv_schedule_time"
            android:layout_width="@dimen/stop_viewer_schedule_time_width"
            android:layout_height="match_parent"
            android:text="1:56 am"
            android:gravity="center"
            android:textColor="@android:color/black"
            android:textSize="@dimen/layer_text_size_sp"
            />
    </LinearLayout>

</LinearLayout>
