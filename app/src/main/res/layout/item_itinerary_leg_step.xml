<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_search_list"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/padding_small"
    android:paddingBottom="@dimen/padding_small"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_indicator"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginStart="23dp"
        android:layout_marginEnd="33dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/ic_circle"
        android:backgroundTint="@android:color/white" />

    <ImageView
        android:id="@+id/iv_step_direction"
        android:layout_width="@dimen/layer_icon_size"
        android:layout_height="@dimen/layer_icon_size"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_gravity="center_vertical"
        app:tint="@color/colorDarkGrey" />

    <TextView 
        android:id="@+id/tv_step_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
		android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:textColor="@color/colorDarkGrey"
        android:textSize="@dimen/address_list_view_text_size_sp"/>
</LinearLayout>