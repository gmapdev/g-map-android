<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_white_with_shadow_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    >
    <LinearLayout
        android:id="@+id/ll_vehicle_on_route"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_small"
        android:orientation="vertical"
        >
        <TextView
            android:id="@+id/tv_marker_vehicle_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:textColor="@android:color/black"
            android:textSize="@dimen/content_text_size"
            android:textStyle="bold"
            android:text="Vehicle 166866:"/>
        <TextView
            android:id="@+id/tv_marker_vehicle_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            android:text="16 seconds ago"
            android:textColor="@android:color/black"
            android:textSize="@dimen/layer_text_size"/>

        <TextView
            android:id="@+id/tv_marker_vehicle_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_small"
            android:text="travel at 16 mph"
            android:textColor="@android:color/black"
            android:textSize="@dimen/layer_text_size"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_stop_parking_marker_popup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        >
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <com.android.volley.toolbox.NetworkImageView
                    android:id="@+id/iv_agency_logo"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center_vertical"
                    />
                <TextView
                    android:id="@+id/tv_map_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="245dp"
                    android:minWidth="145dp"
                    android:text="65 Huntington Road NE, Atlanta, GA"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/address_input_text_size_sp"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_marker_stop_viewer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/stop_id_colon"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/layer_text_size"/>

                <TextView
                    android:id="@+id/tv_marker_stop_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_gravity="center_vertical"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/layer_text_size"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_action_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/ll_marker_btn_stop_viewer"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/aoda_height"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/padding_small"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/grey_frame_rounded_white_bg"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="@dimen/stop_marker_icon_size"
                            android:layout_height="@dimen/stop_marker_icon_size"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/ic_marker_stop"
                            />
                        <TextView
                            android:id="@+id/tv_marker_stop_viewer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/margin_small"
                            android:text="@string/stop_viewer"
                            android:textColor="@color/colorStopViewerButtonBlue"
                            android:textSize="@dimen/layer_text_size"/>
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_marker_btn_from_here"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/aoda_height"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/padding_small"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/grey_frame_rounded_white_bg"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="@dimen/stop_marker_icon_size"
                            android:layout_height="@dimen/stop_marker_icon_size"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/ic_start_trip"
                            />
                        <TextView
                            android:id="@+id/tv_marker_from_here"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/margin_small"
                            android:text="@string/from_here"
                            android:textColor="@color/colorStopViewerButtonBlue"
                            android:textSize="@dimen/layer_text_size"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_marker_btn_to_here"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/aoda_height"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/padding_small"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/grey_frame_rounded_white_bg"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="@dimen/stop_marker_icon_size"
                            android:layout_height="@dimen/stop_marker_icon_size"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/ic_end"
                            />

                        <TextView
                            android:id="@+id/tv_marker_to_here"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="@dimen/aoda_width"
                            android:layout_marginStart="@dimen/margin_small"
                            android:layout_gravity="center_vertical"
                            android:text="@string/to_here"
                            android:textColor="@color/colorStopViewerButtonBlue"
                            android:textSize="@dimen/layer_text_size"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_marker_view_close"
            android:layout_width="@dimen/aoda_width"
            android:layout_height="@dimen/aoda_height"
            android:src="@drawable/ic_cancel"
            android:padding="16dp"
            android:contentDescription="@string/close"
            />
    </LinearLayout>


</LinearLayout>

