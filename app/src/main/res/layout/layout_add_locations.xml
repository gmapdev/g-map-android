<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"

    >
    <LinearLayout
        android:id="@+id/ll_current_locations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        android:orientation="vertical"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_medium"
            android:text="@string/add_your_locations_hint"
            android:textColor="@android:color/black"
            android:textSize="@dimen/content_text_size_sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:layout_marginTop="@dimen/margin_medium"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/ll_add_home_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/add_location_height"
                android:layout_weight="1"
                android:background="@drawable/rounded_white_with_shadow_bg"
                android:orientation="horizontal"
                >
                <ImageView
                    android:layout_width="@dimen/icon_width"
                    android:layout_height="@dimen/icon_height"
                    android:padding="@dimen/padding_medium"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_home"
                    />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/margin_small"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/title_text_size_sp"
                        android:accessibilityHeading="true"
                        tools:targetApi="p"
                        />
                    <TextView
                        android:id="@+id/tv_home_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="10"
                        android:ellipsize="end"
                        android:hint="@string/set_home_address"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/content_text_size_sp"
                        />
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/rl_delete_home_address"
                android:layout_width="@dimen/add_location_height"
                android:layout_height="@dimen/add_location_height"
                android:layout_marginStart="@dimen/margin_small"
                android:background="@drawable/rounded_white_with_shadow_bg"
                android:visibility="gone"
                android:contentDescription="@string/delete_home"
                >
                <ImageView
                    android:layout_width="@dimen/icon_width"
                    android:layout_height="@dimen/icon_height"
                    android:padding="@dimen/padding_small"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_delete"

                    />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:background="@android:color/white"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/ll_add_work_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/add_location_height"
                android:layout_weight="1"
                android:background="@drawable/rounded_white_with_shadow_bg"
                android:orientation="horizontal"
                >
                <ImageView
                    android:layout_width="@dimen/icon_width"
                    android:layout_height="@dimen/icon_height"
                    android:padding="@dimen/padding_medium"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_work"
                    />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/margin_small"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/work"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/title_text_size_sp"
                        android:accessibilityHeading="true"
                        tools:targetApi="p"
                        />
                    <TextView
                        android:id="@+id/tv_work_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/set_work_address"
                        android:maxLines="10"
                        android:ellipsize="end"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/content_text_size_sp"
                        />
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/rl_delete_work_address"
                android:layout_width="@dimen/add_location_height"
                android:layout_height="@dimen/add_location_height"
                android:layout_marginStart="@dimen/margin_small"
                android:background="@drawable/rounded_white_with_shadow_bg"
                android:visibility="gone"
                android:contentDescription="@string/delete_work"
                >
                <ImageView
                    android:layout_width="@dimen/icon_width"
                    android:layout_height="@dimen/icon_height"
                    android:padding="@dimen/padding_small"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_delete"

                    />
            </RelativeLayout>
        </LinearLayout>

        <ListView
            android:id="@+id/lv_added_locations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:divider="@android:color/transparent"
            android:dividerHeight="@dimen/margin_medium"
            />

        <LinearLayout
            android:id="@+id/ll_add_another_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/add_location_height"
            android:layout_marginTop="@dimen/margin_medium"
            android:background="@drawable/rounded_white_with_shadow_bg"
            android:orientation="horizontal"
            >
            <ImageView
                android:layout_width="@dimen/icon_width"
                android:layout_height="@dimen/icon_height"
                android:padding="@dimen/padding_medium"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_account_add"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/margin_small"
                android:text="@string/add_another_place"
                android:textColor="@android:color/black"
                android:textSize="@dimen/title_text_size_sp"
                android:accessibilityHeading="true"
                tools:targetApi="p"
                />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>


