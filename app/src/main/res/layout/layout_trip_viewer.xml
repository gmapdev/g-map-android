<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium"
        android:textColor="@android:color/black"
        android:textSize="@dimen/title_text_size"
        android:accessibilityHeading="true"
        tools:targetApi="p"
        android:textStyle="bold"
        android:text="@string/trip_viewer"
        android:background="@color/colorGrey"/>

    <TextView
        android:id="@+id/tv_trip_viewer_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium"
        android:textColor="@android:color/black"
        android:textSize="@dimen/content_text_size"
        android:text="Route: 1 Marietta Blvd/Joseph E Lowery Blvd"
        />

    <LinearLayout
        android:id="@+id/ll_trip_viewer_transit_allowed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <LinearLayout
            android:id="@+id/ll_trip_viewer_bikes_allowed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/padding_small"
            android:paddingEnd="@dimen/padding_small"
            android:layout_marginStart="@dimen/margin_medium"
            android:background="@drawable/rounded_green_bg"
            android:orientation="horizontal"
            >
            <ImageView
                android:layout_width="@dimen/layer_icon_size"
                android:layout_height="@dimen/layer_icon_size"
                android:padding="@dimen/padding_small"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_bicycle_white"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textColor="@android:color/white"
                android:textSize="@dimen/layer_text_size"
                android:text="@string/allowed"
                android:textStyle="bold"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_trip_viewer_trip_bikes_allowed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/padding_small"
            android:paddingEnd="@dimen/padding_small"
            android:layout_marginStart="@dimen/margin_medium"
            android:background="@drawable/rounded_green_bg"
            android:orientation="horizontal"
            >
            <ImageView
                android:layout_width="@dimen/layer_icon_size"
                android:layout_height="@dimen/layer_icon_size"
                android:padding="@dimen/padding_small"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_tripbike_white"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textColor="@android:color/white"
                android:textSize="@dimen/layer_text_size"
                android:text="@string/allowed"
                android:textStyle="bold"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_trip_viewer_accessible_allowed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/padding_small"
            android:paddingEnd="@dimen/padding_small"
            android:layout_marginStart="@dimen/margin_medium"
            android:background="@drawable/rounded_green_bg"
            android:backgroundTint="@color/colorTripViewerAccessibilityAllowedBG"
            android:orientation="horizontal"
            >
            <ImageView
                android:layout_width="@dimen/layer_icon_size"
                android:layout_height="@dimen/layer_icon_size"
                android:padding="@dimen/padding_small"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_accessible_white"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textColor="@android:color/white"
                android:textSize="@dimen/layer_text_size"
                android:text="@string/allowed"
                android:textStyle="bold"
                />
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/lv_trip_viewer_stops"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="@dimen/margin_medium"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        />
</LinearLayout>
