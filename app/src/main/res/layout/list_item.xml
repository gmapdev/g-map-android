<?xml version="1.0" encoding="utf-8"?><!-- res/layout/group_header.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:id="@+id/ll_list_item"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:layout_gravity="end"
        android:gravity="end"
        android:layout_marginStart="@dimen/margin_large"
        android:background="@drawable/rounded_black_border_grey"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/expandIcon"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_up"
            app:tint="@color/colorBlack" />

        <TextView
            android:id="@+id/list_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="@dimen/padding_medium"
            android:text="N/A"
            android:textColor="#000000"
            android:textSize="@dimen/small_text_size" />

        <TextView
            android:id="@+id/list_item_cost"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:padding="@dimen/padding_medium"
            android:text="$0.00"
            android:textColor="#000000"
            android:textSize="@dimen/small_text_size" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_reduce_fares"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium_large"
        android:layout_marginEnd="@dimen/margin_medium_large"
        android:layout_marginTop="@dimen/margin_medium"
        android:accessibilityHeading="true"
        android:text="@string/reduce_fares"
        android:textColor="@color/colorBlack"
        android:textSize="@dimen/content_text_size"
        android:textStyle="bold"
        android:visibility="gone"/>
</LinearLayout>



