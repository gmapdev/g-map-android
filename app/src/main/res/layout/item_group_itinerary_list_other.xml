<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_itinearary_accessible_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/accessibile">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/padding_small"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small"
            android:layout_marginStart="@dimen/margin_large"
            >

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_wheelchair"/>
            <ImageView
                android:id="@+id/iv_itinerary_accessible_status"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_like"
                android:layout_marginStart="2dp"/>


        </LinearLayout>
    </LinearLayout>

   <LinearLayout
       android:id="@+id/ll_itinearary_other_bg"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="horizontal"
       >

    <RelativeLayout
        android:id="@+id/rl_mode"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/rounded_primary_bg"
        android:backgroundTint="@android:color/black"
        >
        <ImageView
            android:id="@+id/iv_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_bike"
            app:tint="@android:color/white"
            android:layout_centerInParent="true"
            />
    </RelativeLayout>
    <TextView
        android:id="@+id/tv_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/margin_medium"
        android:textSize="@dimen/content_text_size_sp"
        android:textColor="@android:color/black"
        android:text="Bike"
        />
    <TextView
        android:id="@+id/tv_duration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="@dimen/itinerary_list_text_size_sp"
        android:textColor="@android:color/black"
        android:text="39 min"
        android:accessibilityHeading="true"
        tools:targetApi="p"
        android:textStyle="bold"
        android:gravity="end|center_vertical"
        android:layout_gravity="center_vertical"
        android:focusableInTouchMode="true"
        />

   </LinearLayout>

</LinearLayout>