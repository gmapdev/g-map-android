<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:padding="@dimen/padding_medium"
            android:src="@drawable/ic_login_logo" />
        <!--            <TextView-->
        <!--                android:layout_width="wrap_content"-->
        <!--                android:layout_height="wrap_content"-->
        <!--                android:layout_marginTop="@dimen/margin_medium"-->
        <!--                android:layout_gravity="center_horizontal"-->
        <!--                android:textColor="@android:color/white"-->
        <!--                android:textSize="@dimen/title_text_size"-->
        <!--                android:accessibilityHeading="true"-->
        <!--                tools:targetApi="p"-->
        <!--                android:text="@string/app_name"-->
        <!--                />-->
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_auth0_tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/ll_log_in_tab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_log_in_tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginBottom="@dimen/margin_medium"
                android:text="@string/log_in"
                android:textColor="@color/colorHighlightText"
                android:textSize="@dimen/content_text_size" />

            <TextView
                android:id="@+id/tv_log_in_tab_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorHighlightText" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_sign_up_tab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_sign_up_tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginBottom="@dimen/margin_medium"
                android:text="@string/sign_up"
                android:textColor="@color/colorUnhighlightText"
                android:textSize="@dimen/content_text_size" />

            <TextView
                android:id="@+id/tv_sign_up_tab_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorUnhighlightDivider" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_forget_password"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margin_extra_large"
            android:layout_marginEnd="@dimen/margin_extra_large"
            android:text="@string/reset_password_text"
            android:textColor="@android:color/black"
            android:textSize="@dimen/content_text_size" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginStart="@dimen/margin_extra_large"
            android:layout_marginTop="@dimen/margin_extra_large"
            android:layout_marginEnd="@dimen/margin_extra_large"
            android:layout_marginBottom="@dimen/padding_extra_large"
            android:padding="@dimen/padding_medium">

            <ImageView
                android:id="@+id/iv_email_forget"
                android:layout_width="@dimen/icon_width"
                android:layout_height="wrap_content"
                android:background="@drawable/left_rounded_light_grey_bg"
                android:padding="@dimen/padding_medium"
                android:src="@drawable/ic_email_login" />

            <EditText
                android:id="@+id/et_email_forget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_toEndOf="@+id/iv_email_forget"
                android:background="@null"
                android:hint="@string/email_hint"
                android:inputType="textEmailAddress|textMultiLine"
                android:maxLines="4"
                android:paddingEnd="@dimen/margin_medium" />

            <RelativeLayout
                android:id="@+id/rl_email_frame_forget"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/grey_frame_rounded_transparent_bg" />
        </RelativeLayout>

    </LinearLayout>

    <ScrollView
        android:id="@+id/sv_sign_in_and_up"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_extra_large"
                android:layout_marginTop="@dimen/margin_extra_large"
                android:layout_marginEnd="@dimen/margin_extra_large"
                android:background="@drawable/grey_frame_rounded_transparent_bg"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/iv_email"
                    android:layout_width="@dimen/icon_width"
                    android:layout_height="0dp"
                    android:background="@drawable/left_rounded_light_grey_bg"
                    android:paddingStart="@dimen/padding_small"
                    android:paddingTop="2dp"
                    android:paddingEnd="@dimen/padding_small"
                    android:paddingBottom="2dp"
                    android:src="@drawable/ic_email_login"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/et_email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:background="@null"
                    android:hint="@string/email_hint"
                    android:inputType="textEmailAddress|textMultiLine"
                    android:scrollbars="horizontal"
                    android:padding="@dimen/padding_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_email"
                    app:layout_constraintTop_toTopOf="parent" />

                <RelativeLayout
                    android:id="@+id/rl_email_frame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/grey_frame_rounded_transparent_bg"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/ll_email_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_extra_large"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginEnd="@dimen/margin_extra_large"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_alerts"
                    app:tint="@android:color/holo_red_light" />

                <TextView
                    android:id="@+id/tv_email_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:text="Wrong email format"
                    android:textColor="@android:color/holo_red_light"
                    android:textSize="@dimen/layer_text_size" />

            </LinearLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_extra_large"
                android:layout_marginTop="@dimen/margin_extra_large"
                android:layout_marginEnd="@dimen/margin_extra_large"
                android:background="@drawable/grey_frame_rounded_transparent_bg"
                android:padding="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/linearLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/iv_password"
                        android:layout_width="@dimen/icon_width"
                        android:layout_height="0dp"
                        android:background="@drawable/left_rounded_light_grey_bg"
                        android:paddingStart="@dimen/padding_small"
                        android:paddingTop="2dp"
                        android:paddingEnd="@dimen/padding_small"
                        android:paddingBottom="2dp"
                        android:src="@drawable/ic_password_login"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/your_password"
                        android:inputType="textPassword|textMultiLine"
                        android:scrollbars="horizontal"
                        android:padding="@dimen/padding_medium"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/iv_hide_password"
                        app:layout_constraintStart_toEndOf="@+id/iv_password"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_hide_password"
                        android:layout_width="@dimen/icon_width"
                        android:layout_height="0dp"
                        android:paddingStart="@dimen/padding_small"
                        android:paddingTop="2dp"
                        android:paddingEnd="@dimen/padding_small"
                        android:paddingBottom="2dp"
                        android:src="@drawable/ic_invisible_login"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <RelativeLayout
                    android:id="@+id/rl_password_frame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/grey_frame_rounded_transparent_bg"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/ll_password_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_extra_large"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginEnd="@dimen/margin_extra_large"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_alerts"
                    android:layout_marginTop="@dimen/margin_small"
                    app:tint="@android:color/holo_red_light" />

                <TextView
                    android:id="@+id/tv_password_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:text="Password can't be blank"
                    android:textColor="@android:color/holo_red_light"
                    android:textSize="@dimen/layer_text_size"
                    android:visibility="visible" />

            </LinearLayout>


            <TextView
                android:id="@+id/tv_forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_medium"
                android:padding="@dimen/padding_medium"
                android:text="@string/dont_remember_password"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size" />

            <LinearLayout
                android:id="@+id/ll_sign_up_password_requirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_extra_large"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/margin_extra_large"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:text="@string/your_password_must_contain"
                    android:textColor="@color/colorSignUpPasswordGreen"
                    android:textSize="@dimen/layer_text_size" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_extra_large"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_at_least_eight_characters"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_circle"
                        android:backgroundTint="@color/colorSignUpPasswordGreen"
                        android:padding="3dp"
                        android:src="@drawable/ic_checkmark"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_at_least_eight_characters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/margin_small"
                        android:text="@string/at_least_eight_characters"
                        android:textColor="@color/colorSignUpPasswordGreen"
                        android:textSize="@dimen/layer_text_size" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_extra_large"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_types_characters"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_circle"
                        android:backgroundTint="@color/colorSignUpPasswordRed"
                        android:padding="3dp"
                        android:src="@drawable/ic_cancel"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_types_characters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/margin_small"
                        android:text="@string/at_least_3_out_of_4_types_characters"
                        android:textColor="@color/colorSignUpPasswordRed"
                        android:textSize="@dimen/layer_text_size" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_extra_large"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_lower_case_letters"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/ic_circle"
                        android:backgroundTint="@color/colorSignUpPasswordGreen"
                        android:padding="3dp"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_lower_case_letters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/margin_small"
                        android:text="@string/lower_case_letters"
                        android:textColor="@color/colorSignUpPasswordGreen"
                        android:textSize="@dimen/layer_text_size" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_extra_large"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_upper_case_letters"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/ic_circle"
                        android:backgroundTint="@color/colorGrey"
                        android:padding="3dp"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_upper_case_letters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/margin_small"
                        android:text="@string/upper_case_letters"
                        android:textColor="@color/colorGrey"
                        android:textSize="@dimen/layer_text_size" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_extra_large"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_numbers"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/ic_circle"
                        android:backgroundTint="@color/colorGrey"
                        android:padding="3dp"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_numbers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/margin_small"
                        android:text="@string/numbers"
                        android:textColor="@color/colorGrey"
                        android:textSize="@dimen/layer_text_size" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_extra_large"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_special_characters"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/ic_circle"
                        android:backgroundTint="@color/colorGrey"
                        android:padding="3dp"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_special_characters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/margin_small"
                        android:text="@string/special_characters"
                        android:textColor="@color/colorGrey"

                        android:textSize="@dimen/layer_text_size" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_sign_up_terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_medium"
                android:background="@color/colorTransitModeBG"
                android:gravity="center_horizontal"
                android:padding="@dimen/padding_medium"
                android:text="@string/sign_up_terms"
                android:textColor="@android:color/black"
                android:visibility="gone"
                android:textSize="@dimen/content_text_size" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/ll_log_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/colorPrimary"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="@dimen/padding_extra_large">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log_in"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="@dimen/address_input_text_size" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_small"
            android:src="@drawable/ic_right_arrow" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/ll_sign_up"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/colorPrimary"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="@dimen/padding_extra_large">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sign_up"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="@dimen/address_input_text_size" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_small"
            android:src="@drawable/ic_right_arrow" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_send_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/colorPrimary"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="@dimen/padding_extra_large"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/send_email"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="@dimen/address_input_text_size" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_small"
            android:src="@drawable/ic_right_arrow" />
    </LinearLayout>

</LinearLayout>
