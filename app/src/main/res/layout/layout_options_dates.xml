<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Spinner aligned to the left -->
    <Spinner
        android:id="@+id/sp_search_options"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:layout_marginStart="@dimen/margin_medium"
        android:background="@color/white"
        android:popupBackground="@android:color/transparent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_more_options"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_weight="1.25" />

    <!-- TextView for "More options" aligned to the right -->
    <TextView
        android:id="@+id/tv_more_options"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        android:gravity="end"
        android:text="@string/more_options"
        android:textColor="@color/colorBlack"
        android:textSize="@dimen/content_text_size_min"
        android:ellipsize="none"
        android:singleLine="false"
        android:maxLines="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sp_search_options"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_weight="0.75" />

    <LinearLayout
        android:id="@+id/ll_arrive_by_date_time_advance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_extra_large"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sp_search_options">

        <RelativeLayout
            android:id="@+id/rl_arrive_by_option_date_advance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/text_hit_box_height"
            android:layout_marginStart="@dimen/margin_medium"
            >

            <LinearLayout
                android:id="@+id/ll_arrive_by_option_date_advance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:minHeight="@dimen/spinner_height"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_arrive_by_option_date_advance"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp" />

                <ImageView
                    android:layout_width="@dimen/layer_icon_size"
                    android:layout_height="@dimen/layer_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/colorModesBackground"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/ll_arrive_by_option_date_advance"
                android:background="@android:color/black" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_arrive_by_option_time_advance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/margin_medium"
            android:layout_weight="1"
            android:minHeight="@dimen/text_hit_box_height">

            <LinearLayout
                android:id="@+id/ll_arrive_by_option_time_advance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:minHeight="@dimen/spinner_height"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_arrive_by_option_time_advance"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp" />

                <ImageView
                    android:layout_width="@dimen/layer_icon_size"
                    android:layout_height="@dimen/layer_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/colorModesBackground"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/ll_arrive_by_option_time_advance"
                android:background="@android:color/black" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_depart_after_date_time_advance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_extra_large"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sp_search_options">

        <RelativeLayout
            android:id="@+id/rl_option_date_advance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/text_hit_box_height"
            android:layout_marginStart="@dimen/margin_medium"
            >

            <LinearLayout
                android:id="@+id/ll_option_date_advance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:minHeight="@dimen/spinner_height"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_option_date_advance"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp" />

                <ImageView
                    android:layout_width="@dimen/layer_icon_size"
                    android:layout_height="@dimen/layer_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/colorModesBackground"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/ll_option_date_advance"
                android:background="@android:color/black" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_option_time_advance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/margin_medium"
            android:minHeight="@dimen/text_hit_box_height">

            <LinearLayout
                android:id="@+id/ll_option_time_advance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:minHeight="@dimen/spinner_height"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_option_time_advance"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp" />

                <ImageView
                    android:layout_width="@dimen/layer_icon_size"
                    android:layout_height="@dimen/layer_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/colorModesBackground"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/ll_option_time_advance"
                android:background="@android:color/black" />
        </RelativeLayout>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>

