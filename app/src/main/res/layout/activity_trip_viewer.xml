<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows = "true"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <com.mapbox.mapboxsdk.maps.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />
        <ImageView
            android:id="@+id/iv_trip_viewer_back"
            android:layout_width="@dimen/aoda_width"
            android:layout_height="@dimen/aoda_height"
            android:layout_margin="@dimen/margin_medium"
            android:scaleType="centerInside"
            android:src="@drawable/ic_leftarrow"
            android:background="@drawable/ic_layer_bkg_default"
            android:contentDescription="@string/back_button"/>

        <LinearLayout
            android:id="@+id/ll_trip_viewer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@drawable/top_rounded_white_with_shadow_bg"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iv_trip_viewer_expander"
                android:layout_width="match_parent"
                android:layout_height="@dimen/icon_height"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_handle"
                android:scaleType="centerInside"
                app:tint="@color/colorDarkGrey"
                android:contentDescription="@string/trip_viewer_expander"
                android:visibility="gone"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="@dimen/margin_small"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_trip_viewer_route"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:layout_gravity="center_vertical"
                    android:paddingStart="@dimen/padding_medium"
                    android:paddingEnd="@dimen/padding_medium"
                    android:paddingTop="@dimen/padding_small"
                    android:paddingBottom="@dimen/padding_small"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp"
                    android:text="1"
                    android:background="@drawable/rounded_transit_mode_bg"
                    />

                <TextView
                    android:id="@+id/tv_trip_viewer_route_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_gravity="center_vertical"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:text="Marietta Blvd/Joseph E Lowery Blvd"
                    android:textStyle="bold"
                    android:maxLines="10"
                    android:ellipsize="end"
                    />

                <com.android.volley.toolbox.NetworkImageView
                    android:id="@+id/iv_agency_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_trip_viewer_transit_allowed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:orientation="horizontal"
                >
                <LinearLayout
                    android:id="@+id/ll_trip_viewer_bikes_allowed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/padding_small"
                    android:paddingEnd="@dimen/padding_small"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:background="@drawable/rounded_green_bg"
                    android:orientation="horizontal"
                    >
                    <ImageView
                        android:layout_width="@dimen/layer_icon_size"
                        android:layout_height="@dimen/layer_icon_size"
                        android:padding="@dimen/padding_small"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_bicycle_white"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/layer_text_size"
                        android:text="@string/allowed"
                        android:textStyle="bold"
                        />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_trip_viewer_trip_bikes_allowed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/padding_small"
                    android:paddingEnd="@dimen/padding_small"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:background="@drawable/rounded_green_bg"
                    android:orientation="horizontal"
                    >
                    <ImageView
                        android:layout_width="@dimen/layer_icon_size"
                        android:layout_height="@dimen/layer_icon_size"
                        android:padding="@dimen/padding_small"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_tripbike_white"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/layer_text_size"
                        android:text="@string/allowed"
                        android:textStyle="bold"
                        />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_trip_viewer_accessible_allowed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/padding_small"
                    android:paddingEnd="@dimen/padding_small"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:background="@drawable/rounded_green_bg"
                    android:backgroundTint="@color/colorTripViewerAccessibilityAllowedBG"
                    android:orientation="horizontal"
                    >
                    <ImageView
                        android:layout_width="@dimen/layer_icon_size"
                        android:layout_height="@dimen/layer_icon_size"
                        android:padding="@dimen/padding_small"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_accessible_white"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/layer_text_size"
                        android:text="@string/allowed"
                        android:textStyle="bold"
                        />
                </LinearLayout>
            </LinearLayout>
            <ListView
                android:id="@+id/lv_trip_viewer_stops"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="@dimen/margin_medium"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                />
        </LinearLayout>

    </RelativeLayout>
</LinearLayout>
