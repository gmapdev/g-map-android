<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddressSearchActivity"
    android:fitsSystemWindows = "true"
    android:orientation="vertical">
    <include
        android:id="@+id/rl_header"
        layout="@layout/layout_header"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginStart="@dimen/margin_extra_large"
        android:layout_marginEnd="@dimen/margin_extra_large"
        android:orientation="horizontal"
        >
        <ImageView
            android:id="@+id/iv_from_to"
            android:layout_width="@dimen/icon_size_in_address_search"
            android:layout_height="@dimen/icon_size_in_address_search"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_start_trip"
            />
        <AutoCompleteTextView
            android:id="@+id/at_search"
            android:layout_width="0dp"
            android:layout_height="@dimen/input_box_height"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_medium"
            android:hint="@string/from_hint"
            android:layout_gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end"
            android:imeOptions="actionSearch"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:background="@android:color/transparent"
            android:textColorHint="@color/colorHintText"
            android:textSize="@dimen/address_input_text_size_sp"
            />
        <ImageView
            android:id="@+id/iv_clear"
            android:layout_width="@dimen/medium_icon_width"
            android:layout_height="@dimen/medium_icon_height"
            android:layout_gravity="center_vertical"
            android:padding="@dimen/padding_medium"
            android:src="@drawable/ic_cancel"
            app:tint="@color/colorDarkGrey" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/margin_extra_large"
        android:layout_marginEnd="@dimen/margin_extra_large"
        android:background="@android:color/black"/>

    <ListView
        android:id="@+id/lv_auto_complete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:layout_marginStart="@dimen/margin_extra_large"
        android:layout_marginEnd="@dimen/margin_extra_large"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/list_view_divider_height"

        />

    <TextView
        android:id="@+id/tv_recently_searched"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_extra_large"
        android:layout_marginEnd="@dimen/margin_extra_large"
        android:layout_marginTop="@dimen/margin_medium"
        android:textColor="@color/colorRecentSearched"
        android:textSize="@dimen/content_text_size_sp"
        android:textStyle="bold"
        android:text="@string/recently_searched"/>

    <ListView
        android:id="@+id/lv_recently_searched"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:layout_marginStart="@dimen/margin_extra_large"
        android:layout_marginEnd="@dimen/margin_extra_large"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/list_view_divider_height"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginStart="@dimen/margin_extra_large"
        android:layout_marginEnd="@dimen/margin_extra_large"
        android:layout_marginTop="@dimen/margin_medium"
        android:orientation="horizontal"
        >
        <ImageView
            android:id="@+id/iv_current_location"
            android:layout_width="@dimen/icon_size_in_address_search"
            android:layout_height="@dimen/icon_size_in_address_search"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_notfound"
            />
        <TextView
            android:id="@+id/tv_current_location"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/aoda_height"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_gravity="center_vertical"
            android:textColor="@android:color/black"
            android:textSize="@dimen/address_list_view_text_size_sp"
            android:text="@string/current_location_not_available"/>
    </LinearLayout>
</LinearLayout>