<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/rl_home"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:mapbox="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows = "true"
    tools:context=".HomeActivity"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/rl_header"
            layout="@layout/layout_header"
            />
        <include
            android:id="@+id/ll_search_bar"
            layout="@layout/layout_search_bar"
            />
        <include
            android:id="@+id/ll_route_search_address"
            layout="@layout/layout_route_search_address"
            android:visibility="gone"
            />
        <RelativeLayout
            android:id="@+id/rl_map_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            >
            <com.mapbox.mapboxsdk.maps.MapView
                android:id="@+id/map_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                />

            <LinearLayout
                android:layout_width="33dp"
                android:layout_height="67dp"
                android:layout_margin="@dimen/margin_medium"
                android:orientation="vertical"
                android:background="@drawable/grey_frame_rounded_white_bg"
                >
                <ImageView
                    android:id="@+id/iv_zoom_plus"
                    android:layout_width="@dimen/medium_icon_width"
                    android:layout_height="@dimen/medium_icon_height"
                    android:padding="@dimen/small_icon_padding"
                    android:src="@drawable/ic_plus"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorGrey"/>
                <ImageView
                    android:id="@+id/iv_zoom_minus"
                    android:layout_width="@dimen/medium_icon_width"
                    android:layout_height="@dimen/medium_icon_height"
                    android:padding="@dimen/small_icon_padding"
                    android:src="@drawable/ic_minus"
                    />
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/rl_layer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_margin="@dimen/margin_medium"
                android:contentDescription="@string/map_settings"
                >
                <ImageView
                    android:id="@+id/iv_layer_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_layer_bkg_default"
                    />

                <ImageView
                    android:id="@+id/iv_layer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_layer" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rl_locate_me"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="@dimen/margin_large"
                android:layout_marginEnd="@dimen/margin_medium"
                >
                <ImageView
                    android:id="@+id/iv_locate_me_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_layer_bkg_default"
                    />
                <ImageView
                    android:id="@+id/iv_locate_me"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_locateme"
                    />
            </RelativeLayout>

            <include
                android:id="@+id/ll_layout_layers"
                layout="@layout/layout_layers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:visibility="gone"
                />

            <include
                android:id="@+id/ll_home_setting"
                layout="@layout/layout_home_setting"
                android:visibility="gone"
                />

            <include
                android:id="@+id/ll_home_date_time"
                layout="@layout/layout_home_date_time"
                android:visibility="gone"
                />

            <LinearLayout
                android:id="@+id/ll_expand_map_controller"
                android:layout_width="126dp"
                android:layout_height="36dp"
                android:layout_margin="@dimen/margin_medium"
                android:layout_alignParentBottom="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/grey_frame_rounded_white_bg"
                android:visibility="gone"
                >
                <ImageView
                    android:id="@+id/iv_expand_map_controller"
                    android:layout_width="@dimen/layer_icon_size"
                    android:layout_height="@dimen/layer_icon_size"
                    android:padding="@dimen/padding_small"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_expand"
                    />
                <TextView
                    android:id="@+id/tv_expand_map_controller"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/expand_map"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/address_list_view_text_size"
                    />

            </LinearLayout>
        </RelativeLayout>
        <include
            android:id="@+id/ll_itinerary_list"
            layout="@layout/layout_itinerary_list"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1.5"
            android:visibility="gone"
             />

        <include
            android:id="@+id/ll_itinerary_detail"
            layout="@layout/layout_itinerary_detail"
            android:visibility="gone"
            />

        <include
            android:id="@+id/rl_activity_active_route"
            layout="@layout/activity_avtive_route"
            android:visibility="gone"
            />

        <include
            android:id="@+id/ll_stop_viewer"
            layout="@layout/layout_stop_viewer"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="2"
            android:visibility="gone"
            />

        <include
            android:id="@+id/ll_trip_viewer"
            layout="@layout/layout_trip_viewer"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="2"
            android:visibility="gone"
            />

        <include
            android:id="@+id/ll_route_viewer"
            layout="@layout/layout_route_viewer"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="2"
            android:visibility="gone"
            />
    </LinearLayout>

    <include
        android:id="@+id/ll_main_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="46dp"
        android:layout_marginStart="3dp"
        layout="@layout/layout_main_menu"
        android:visibility="gone"
        />

    <include
        android:id="@+id/ll_account_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="46dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="3dp"
        layout="@layout/layout_account_menu"
        android:visibility="gone"
        />
    <TimePicker
        android:id="@+id/tp_search_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_extra_large"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:timePickerMode="spinner"
        android:background="@android:color/white"
        android:visibility="gone"/>

    <DatePicker
        android:id="@+id/dp_search_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_extra_large"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:visibility="gone"
        android:datePickerMode="calendar"
        android:background="@android:color/white"
        />

    <DatePicker
        android:id="@+id/dp_stop_viewer_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_extra_large"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:visibility="gone"
        android:datePickerMode="calendar"
        android:background="@android:color/white"
        />


</RelativeLayout>