<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:filterTouchesWhenObscured="true">


    <RelativeLayout
        android:id="@+id/rl_activity_stop_viewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <com.mapbox.mapboxsdk.maps.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/iv_stop_viewer_back"
            android:layout_width="@dimen/aoda_width"
            android:layout_height="@dimen/aoda_height"
            android:layout_margin="@dimen/margin_medium"
            android:background="@drawable/ic_layer_bkg_default"
            android:contentDescription="@string/back_button"
            android:scaleType="centerInside"
            android:src="@drawable/ic_leftarrow" />

        <ScrollView
            android:id="@+id/sv_stop_viewer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="76dp"
            android:background="@drawable/top_rounded_white_with_shadow_bg"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/ll_stop_viewer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_header_holder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/padding_medium"
                    android:paddingTop="@dimen/padding_medium"
                    android:paddingEnd="@dimen/padding_medium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/padding_medium"
                    android:paddingTop="@dimen/padding_medium"
                    android:paddingEnd="@dimen/padding_medium">


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_stop_viewer_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:text="JOSEPH E BOONE BLVD @ ANDREW J HAIRSTON BLVD"
                            android:textColor="@color/colorItineraryBlack"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_stop_viewer_stop_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bold_stop_id_with_num"
                            android:textColor="@color/colorItineraryGrey"
                            android:textSize="@dimen/content_text_size_sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_stop_viewer_save"
                        android:layout_width="@dimen/icon_width"
                        android:layout_height="@dimen/icon_width"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="@string/save_route"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_save_new"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/plan_trip_two_lines"
                        android:textColor="@color/colorItineraryBlack"
                        android:textSize="@dimen/address_input_text_size_sp" />

<!--                    <RelativeLayout-->
<!--                        android:layout_width="0dp"-->
<!--                        android:layout_height="match_parent"-->
<!--                        android:layout_weight="3" />-->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/medium_icon_width"
                            android:layout_height="@dimen/medium_icon_height"
                            android:src="@drawable/ic_origin" />

                        <TextView
                            android:id="@+id/tv_stop_viewer_from_here"
                            android:layout_width="@dimen/aoda_width"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:text="@string/from_here_two_lines"
                            android:textColor="@color/colorStopViewerBlue"
                            android:textSize="@dimen/content_text_size_sp" />
                    </LinearLayout>

<!--                    <RelativeLayout-->
<!--                        android:layout_width="0dp"-->
<!--                        android:layout_height="match_parent"-->
<!--                        android:layout_weight="2" />-->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/medium_icon_width"
                            android:layout_height="@dimen/medium_icon_height"
                            android:padding="@dimen/padding_very_small"
                            android:src="@drawable/ic_end" />

                        <TextView
                            android:id="@+id/tv_stop_viewer_to_here"
                            android:layout_width="@dimen/aoda_width"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:text="@string/to_here_two_lines"
                            android:textColor="@color/colorStopViewerBlue"
                            android:textSize="@dimen/content_text_size_sp" />
                    </LinearLayout>

<!--                    <RelativeLayout-->
<!--                        android:layout_width="0dp"-->
<!--                        android:layout_height="match_parent"-->
<!--                        android:layout_weight="2" />-->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:background="@drawable/rounded_light_grey_bg"
                        android:orientation="horizontal">

                        <RelativeLayout
                            android:id="@+id/rl_departures"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/icon_height"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_white_with_shadow_bg">

                            <TextView
                                android:id="@+id/tv_departures"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:ellipsize="end"
                                android:maxLines="4"
                                android:paddingStart="@dimen/padding_small"
                                android:paddingEnd="@dimen/padding_small"
                                android:text="@string/departures"
                                android:textColor="@android:color/black"
                                android:textSize="@dimen/content_text_size_sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/rl_schedule"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/icon_height"
                            android:layout_weight="1"
                            android:layout_gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_schedule"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:ellipsize="end"
                                android:maxLines="4"
                                android:paddingStart="@dimen/padding_small"
                                android:paddingEnd="@dimen/padding_small"
                                android:text="@string/schedule"
                                android:textColor="@android:color/black"
                                android:textSize="@dimen/content_text_size_sp" />
                        </RelativeLayout>

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_stop_viewer_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:minHeight="@dimen/aoda_height"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_stop_viewer_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="2021-07-02"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/layer_text_size_sp" />

                    <ImageView
                        android:layout_width="@dimen/layer_icon_size"
                        android:layout_height="@dimen/layer_icon_size"
                        android:layout_gravity="center_vertical"
                        android:padding="@dimen/padding_small"
                        android:src="@drawable/ic_calendar_plan" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rl_auto_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:orientation="horizontal">


                    <LinearLayout
                        android:id="@+id/ll_stop_viewer_refresh_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:minHeight="@dimen/aoda_height"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_stop_viewer_refresh_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/ic_refresh" />

                        <TextView
                            android:id="@+id/tv_stop_viewer_refresh_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:ellipsize="end"
                            android:maxWidth="70dp"
                            android:maxLines="4"
                            android:text="3:16 pm"
                            android:textColor="@color/colorItineraryGrey"
                            android:textSize="@dimen/content_text_size_sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_stop_viewer_auto_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="end"
                        android:minHeight="@dimen/aoda_height"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_stop_viewer_auto_refresh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:maxWidth="175dp"
                            android:maxLines="3"
                            android:text="@string/auto_refresh"
                            android:textColor="@color/colorItineraryGrey"
                            android:textSize="@dimen/content_text_size_sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/sw_stop_viewer_auto_refresh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:clickable="false" />

                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_departure_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_margin="@dimen/margin_medium"
                    android:background="@drawable/rounded_departure_bg"
                    android:gravity="center"
                    android:minHeight="@dimen/aoda_height"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_information" />

                    <TextView
                        android:id="@+id/usernameTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="5dp"
                        android:text="@string/departure_pdt"
                        android:textColor="@color/colorItineraryBlack"
                        android:textSize="@dimen/content_text_size_sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_no_data_available"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/margin_medium"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_no_data"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/no_stop_times"
                        android:textColor="@color/colorItineraryBlack"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_margin="@dimen/margin_medium"/>
                </LinearLayout>

                <ListView
                    android:id="@+id/lv_stop_viewer_arrivals_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:layout_weight="1"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="@dimen/margin_medium"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/ll_stop_viewer_schedule_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/stop_viewer_schedule_route_name_width"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/margin_large"
                        android:gravity="center"
                        android:text="@string/route"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/content_text_size_sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/destination"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/content_text_size_sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="@dimen/stop_viewer_schedule_time_width"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center"
                        android:text="@string/departure"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/content_text_size_sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ListView
                    android:id="@+id/lv_stop_viewer_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:layout_weight="1"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="@dimen/margin_small"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <include
            android:id="@+id/ll_bottom_tab"
            layout="@layout/layout_bottom_tab"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_alignParentBottom="true" />

        <include
            android:id="@+id/ll_bottom_tab_menu"
            layout="@layout/layout_bottom_tab_menu_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="76dp"
            android:visibility="gone" />

        <include
            android:id="@+id/ll_bottom_tab_accessibility"
            layout="@layout/layout_bottom_tab_accessibility"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_alignParentBottom="true"
            android:visibility="gone" />

        <RelativeLayout
            android:id="@+id/rl_stop_viewer_date"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorHalfTransparent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <DatePicker
                android:id="@+id/dp_stop_viewer_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@android:color/white"
                android:datePickerMode="calendar"
                android:theme="@style/MyDatePickerStyle" />
        </RelativeLayout>

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/ll_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/white"
        android:orientation="vertical">

        <ListView
            android:id="@+id/left_drawer"
            android:layout_width="300dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="@dimen/margin_medium" />

        <TextView
            android:id="@+id/tv_menu_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_marginBottom="@dimen/margin_medium"
            android:textColor="@android:color/black"
            android:textSize="@dimen/tab_menu_text_size" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
