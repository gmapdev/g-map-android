<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_indoor_navigation"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<!--    <fragment xmlns:android="http://schemas.android.com/apk/res/android"-->
<!--        xmlns:tools="http://schemas.android.com/tools"-->
<!--        android:id="@+id/googleMap"-->
<!--        android:name="com.google.android.gms.maps.SupportMapFragment"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        tools:context=".IndoorNavigationActivity">-->
<!--    </fragment>-->

    <com.jibestream.jmapandroidsdk.rendering_engine.Stage
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The main content view -->
    <RelativeLayout
        android:id="@+id/relative_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <RelativeLayout
            android:id="@+id/rl_controllers"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_search"
                android:layout_width="@dimen/aoda_width"
                android:layout_height="@dimen/aoda_height"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:layout_marginBottom="@dimen/margin_medium"
                android:padding="@dimen/padding_small"
                android:src="@drawable/ic_indoor_search" />

            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="@dimen/aoda_width"
                android:layout_height="@dimen/aoda_height"

                android:layout_marginStart="@dimen/margin_medium"

                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:layout_marginBottom="@dimen/margin_medium"
                android:padding="@dimen/padding_small"
                android:src="@drawable/ic_back"
                />

            <LinearLayout
                android:id="@+id/ll_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/aoda_height"
                android:padding="@dimen/padding_small"
                android:layout_marginStart="68dp"
                android:layout_marginEnd="68dp"
                android:layout_marginTop="@dimen/margin_medium"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/rounded_primary_button">
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="@dimen/title_text_size_sp"
                    android:text="@string/indoor_map"/>
                <ImageView
                    android:id="@+id/iv_title_dropdown"
                    android:layout_width="@dimen/layer_icon_size"
                    android:layout_height="@dimen/layer_icon_size"
                    android:layout_margin="@dimen/margin_medium"
                    android:src="@drawable/ic_sortdown"
                    app:tint="@color/white"
                    />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_locate_me"
                android:layout_width="@dimen/aoda_width"
                android:layout_height="@dimen/aoda_height"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:layout_marginBottom="@dimen/margin_medium"
                android:padding="@dimen/padding_small"
                android:src="@drawable/ic_locateme_enable" />

            <LinearLayout
                android:id="@+id/ll_extend_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginBottom="@dimen/margin_medium"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/iv_upload"
                    android:layout_width="@dimen/aoda_width"
                    android:layout_height="@dimen/aoda_height"
                    android:padding="@dimen/padding_small"
                    android:src="@drawable/ic_cloud" />

                <ImageView
                    android:id="@+id/iv_delete"
                    android:layout_width="@dimen/aoda_width"
                    android:layout_height="@dimen/aoda_height"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:padding="@dimen/padding_small"
                    android:src="@drawable/ic_file_delete" />

                <ImageView
                    android:id="@+id/iv_enable_disable_log"
                    android:layout_width="@dimen/aoda_width"
                    android:layout_height="@dimen/aoda_height"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:padding="@dimen/padding_small"
                    android:src="@drawable/ic_enable" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_origin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_white_with_shadow_bg"
                android:backgroundTint="#ffffffff"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"

                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_origin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="Select a origin"
                    android:textColor="@android:color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_sortdown" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_destination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_white_with_shadow_bg"
                android:backgroundTint="#ffffffff"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"

                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_below="@+id/ll_origin"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_destination"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="Select a destination"
                    android:textColor="@android:color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_sortdown" />
            </LinearLayout>


            <ListView
                android:id="@+id/lv_floors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="68dp"
                android:layout_marginEnd="68dp"
                android:layout_marginTop="68dp"
                android:paddingTop="16dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:visibility="gone"
                />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_search_route"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorHalfTransparent"
            android:visibility="gone"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/margin_extra_large"
                android:layout_marginEnd="@dimen/margin_extra_large"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="60dp"
                android:background="@drawable/rounded_white_with_shadow_bg"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_large"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:padding="@dimen/padding_small"
                    android:minHeight="@dimen/aoda_height"
                    android:background="@drawable/rounded_black_border_grey"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="@dimen/layer_icon_size"
                        android:layout_height="@dimen/layer_icon_size"
                        android:src="@drawable/ic_indoor_origin"
                        android:layout_gravity="center_vertical"/>

                    <EditText
                        android:id="@+id/et_origin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_gravity="center_vertical"
                        android:hint="@string/current_location"
                        android:singleLine="true"
                        android:inputType="text"
                        android:imeOptions="actionSearch"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_large"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:padding="@dimen/padding_small"
                    android:minHeight="@dimen/aoda_height"
                    android:background="@drawable/rounded_black_border_grey"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="@dimen/layer_icon_size"
                        android:layout_height="@dimen/layer_icon_size"
                        android:src="@drawable/ic_indoor_destination"
                        android:layout_gravity="center_vertical"/>

                    <EditText
                        android:id="@+id/et_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_gravity="center_vertical"
                        android:hint="@string/enter_destination_capital"
                        android:singleLine="true"
                        android:inputType="text"
                        android:imeOptions="actionSearch"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:text="@string/available_locations"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/address_input_text_size_sp"
                    android:textStyle="bold"
                    />
                <ListView
                    android:id="@+id/lv_destinations"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tv_cancel_search_route"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/aoda_height"
                        android:layout_weight="1"
                        android:text="@string/cancel"
                        android:textColor="@color/white"
                        android:textSize="@dimen/content_text_size_sp"
                        android:gravity="center"
                        android:background="@drawable/rounded_dark_grey_bg"
                        />

                    <TextView
                        android:id="@+id/tv_search_route"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/aoda_height"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:text="@string/search"
                        android:textColor="@color/white"
                        android:textSize="@dimen/content_text_size_sp"
                        android:gravity="center"
                        android:background="@drawable/rounded_primary_bg"
                        />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_route_instructions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            >

            <RelativeLayout
                android:id="@+id/rl_current_instructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bottom_rounded_dark_primary_bg"
                android:backgroundTint="@color/colorPrimary"
                android:paddingTop="15dp"
                android:paddingBottom="15dp">
                <TextView
                    android:id="@+id/tv_instruction_floor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/aoda_width"
                    android:textColor="@color/white"
                    android:textSize="@dimen/title_text_size_sp"
                    android:layout_centerInParent="true"
                    />
                <ImageView
                    android:id="@+id/iv_first_instruction_close"
                    android:layout_width="@dimen/aoda_width"
                    android:layout_height="@dimen/aoda_height"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:padding="@dimen/padding_small"
                    android:src="@drawable/ic_close_white"
                    />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/margin_medium"
                android:layout_marginBottom="68dp"
                android:orientation="vertical"
                >
                <ImageView
                    android:id="@+id/iv_list"
                    android:layout_width="@dimen/aoda_width"
                    android:layout_height="@dimen/aoda_height"
                    android:layout_marginTop="@dimen/margin_extra_large"
                    android:padding="@dimen/padding_small"
                    android:src="@drawable/ic_list"
                    />
                <ImageView
                    android:id="@+id/iv_mute"
                    android:layout_width="@dimen/aoda_width"
                    android:layout_height="@dimen/aoda_height"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:padding="@dimen/padding_small"
                    android:src="@drawable/ic_mute"
                    android:visibility="gone"
                    />

            </LinearLayout>
            <RelativeLayout
                android:id="@+id/rl_route_instructions_detail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colorHalfTransparent"
                android:visibility="gone"
                >
                <LinearLayout
                    android:id="@+id/ll_route_instructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_extra_large"
                    android:layout_marginBottom="@dimen/margin_extra_large"
                    android:layout_marginStart="@dimen/margin_large"
                    android:layout_marginEnd="@dimen/margin_large"
                    android:background="@drawable/rounded_primary_bg"
                    android:padding="@dimen/padding_medium"
                    android:orientation="vertical"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/route_instructions"
                            android:textSize="@dimen/title_text_size_sp"
                            android:textColor="@color/white"
                            android:layout_gravity="center_vertical"
                            />
                        <ImageView
                            android:id="@+id/iv_route_instruction_close"
                            android:layout_width="@dimen/aoda_width"
                            android:layout_height="@dimen/aoda_height"
                            android:padding="@dimen/padding_medium"
                            android:src="@drawable/ic_indoor_close"
                            />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tv_total_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/content_text_size_sp"
                        android:textColor="@color/white"

                        />
                    <ListView
                        android:id="@+id/lv_route_instructions"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="0dp"
                        />
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:id="@+id/ll_audio_notification_popup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:paddingStart="@dimen/padding_medium"
                android:paddingEnd="@dimen/padding_medium"
                android:paddingTop="@dimen/padding_large"
                android:paddingBottom="@dimen/padding_large"
                android:layout_centerInParent="true"
                android:background="@drawable/rounded_primary_bg"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/iv_audio_notification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_audio_notification"
                    android:layout_gravity="center_horizontal"
                    />

                <TextView
                    android:id="@+id/tv_audio_notification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:textColor="@color/white"
                    android:textSize="@dimen/content_text_size_sp"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center_horizontal"
                    android:text="@string/audio_notification_off"
                    android:textStyle="bold"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_off_route_popup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_extra_large"
                android:paddingStart="@dimen/padding_medium"
                android:paddingEnd="@dimen/padding_medium"
                android:paddingTop="@dimen/padding_large"
                android:paddingBottom="@dimen/padding_large"
                android:layout_centerInParent="true"
                android:background="@drawable/rounded_primary_bg"
                android:orientation="vertical"
                android:visibility="gone"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:textColor="@color/white"
                    android:textSize="@dimen/title_text_size_sp"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center_horizontal"
                    android:text="@string/attention"
                    android:textStyle="bold"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:textColor="@color/white"
                    android:textSize="@dimen/content_text_size_sp"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/off_route_warning_message"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>
                    <ImageView
                        android:id="@+id/iv_cancel_reroute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_indoor_cancel"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>
                    <ImageView
                        android:id="@+id/iv_confirm_reroute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_yes"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>


        <LinearLayout
            android:id="@+id/ll_map_labels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="78dp"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginEnd="@dimen/margin_small"
            android:visibility="gone"
            android:padding="@dimen/padding_medium"
            android:background="@drawable/rounded_white_with_shadow_bg"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_map_label"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/map_labels"
                android:textSize="@dimen/content_text_size"
                android:textColor="@android:color/black"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sc_map_labels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                app:track="@drawable/switch_track_selector"
                app:thumbTint="@color/switch_thumb_unchecked"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_arrive_exit_popup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/margin_large"
            android:layout_marginTop="@dimen/margin_large"
            android:layout_marginEnd="@dimen/margin_large"
            android:layout_marginBottom="@dimen/margin_large"
            android:background="@drawable/rounded_primary_bg"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding_medium"
            android:paddingTop="@dimen/padding_medium"
            android:paddingEnd="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_extra_large"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:text="@string/attention"
                    android:textColor="@color/white"
                    android:textSize="@dimen/title_text_size_sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_arrive_exit_close"
                    android:layout_width="@dimen/aoda_width"
                    android:layout_height="@dimen/aoda_height"
                    android:layout_alignParentEnd="true"
                    android:padding="@dimen/padding_small"
                    android:src="@drawable/ic_indoor_close" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/arrive_exit_popup_message"
                android:textColor="@color/white"
                android:textSize="@dimen/content_text_size_sp" />

            <Button
                android:id="@+id/bt_navigate_to_another_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_marginEnd="@dimen/margin_medium"
                android:background="@drawable/arrive_exit_option_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/aoda_height"
                android:paddingStart="@dimen/padding_medium"
                android:paddingEnd="@dimen/padding_medium"
                android:text="@string/navigate_to_another_room"
                android:textAllCaps="false"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/content_text_size_sp" />

            <Button
                android:id="@+id/bt_start_saved_trip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:background="@drawable/arrive_exit_option_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/aoda_height"
                android:paddingStart="@dimen/padding_medium"
                android:paddingEnd="@dimen/padding_medium"
                android:text="@string/start_saved_trip"
                android:textAllCaps="false"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/content_text_size_sp" />

            <Button
                android:id="@+id/bt_continue_indoor_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:background="@drawable/arrive_exit_option_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/aoda_height"
                android:paddingStart="@dimen/padding_medium"
                android:paddingEnd="@dimen/padding_medium"
                android:text="@string/continue_indoor_navigation"
                android:textAllCaps="false"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/content_text_size_sp" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/pb_loading_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            />
    </RelativeLayout>

</androidx.drawerlayout.widget.DrawerLayout>
