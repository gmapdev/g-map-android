<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/padding_large"
    android:paddingStart="@dimen/padding_large"
    android:paddingEnd="@dimen/padding_large"
    android:paddingBottom="@dimen/padding_medium"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/top_rounded_blue_with_shadow_bg"
    android:orientation="vertical">
    <ImageView
        android:id="@+id/iv_layer_close"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:src="@drawable/btn_layer_close"
        android:paddingStart="@dimen/padding_medium"
        android:paddingEnd="@dimen/padding_medium"
        android:paddingBottom="@dimen/padding_medium"
        android:layout_gravity="center_horizontal"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/map_details"
        android:textSize="@dimen/layer_text_size_sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"/>

    <LinearLayout
        android:id="@+id/ll_layers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:orientation="horizontal"
        android:visibility="visible">
        <LinearLayout
            android:id="@+id/ll_transit_stops"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_medium"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:background="@drawable/grey_frame_rounded_transparent_bg"
            android:backgroundTint="@android:color/white">
            <ImageView
                android:id="@+id/iv_transit_stops"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_transitstop"
                />
            <TextView
                android:id="@+id/tv_transit_stops"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/transit_stops"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_park_and_ride_locations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_medium"
            android:layout_marginStart="@dimen/margin_large"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:backgroundTint="@android:color/white"
            android:contentDescription="@string/park_and_ride">
            <ImageView
                android:id="@+id/iv_park_and_ride_locations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_parking"
                app:tint="@android:color/white"
                />
            <TextView
                android:id="@+id/tv_park_and_ride_locations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/park_and_ride_locations"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_rental_vehicles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_medium"
            android:layout_marginStart="@dimen/margin_large"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:background="@drawable/grey_frame_rounded_transparent_bg"
            android:backgroundTint="@android:color/white">
            <ImageView
                android:id="@+id/iv_rental_vehicles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_layer_scooter"
                />
            <TextView
                android:id="@+id/tv_rental_vehicles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/shared_vehicle"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"/>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_transit_stops_accessibility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="@dimen/margin_medium"
        android:orientation="horizontal"
        android:background="@drawable/grey_frame_rounded_transparent_bg"
        android:backgroundTint="@android:color/white"
        android:visibility="visible"

        >
        <ImageView
            android:id="@+id/iv_transit_stops_accessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_transitstop"
            />
        <TextView
            android:id="@+id/tv_transit_stops_accessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginStart="@dimen/margin_small"
            android:text="@string/transit_stops"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_park_and_ride_locations_accessibility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        android:backgroundTint="@android:color/white"
        android:contentDescription="@string/park_and_ride"
        android:visibility="visible">
        <ImageView
            android:id="@+id/iv_park_and_ride_locations_accessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_parking"
            app:tint="@android:color/white"

            />
        <TextView
            android:id="@+id/tv_park_and_ride_locations_accessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginStart="@dimen/margin_small"
            android:text="@string/park_and_ride_locations"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_rental_vehicles_accessibility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        android:background="@drawable/grey_frame_rounded_transparent_bg"
        android:backgroundTint="@android:color/white">
        <ImageView
            android:id="@+id/iv_rental_vehicles_accessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_layer_scooter"
            />
        <TextView
            android:id="@+id/tv_rental_vehicles_accessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_small"
            android:text="@string/shared_vehicle"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/margin_medium"
        android:background="@android:color/white"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:text="@string/map_type"
        android:textSize="@dimen/layer_text_size_sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/ll_streets"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/aoda_height"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_streets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:paddingStart="@dimen/padding_small"
                android:paddingEnd="@dimen/padding_small"
                android:text="@string/streets"
                android:textSize="@dimen/layer_text_size_sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"/>
            <TextView
                android:id="@+id/tv_streets_highlight"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/white"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_satellite"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/aoda_height"
            android:gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_large"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_satellite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:paddingStart="@dimen/padding_small"
                android:paddingEnd="@dimen/padding_small"
                android:text="@string/satellite"
                android:textSize="@dimen/layer_text_size_sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"/>

            <TextView
                android:id="@+id/tv_satellite_highlight"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/white"
                android:visibility="gone"/>
        </LinearLayout>



    </LinearLayout>


    <LinearLayout
        android:id="@+id/ll_satellite_accessibility"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/aoda_height"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_satellite_accessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingStart="@dimen/padding_small"
            android:paddingEnd="@dimen/padding_small"
            android:text="@string/satellite"
            android:textSize="@dimen/layer_text_size_sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>

        <TextView
            android:id="@+id/tv_satellite_highlight_accessibility"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/white"
            android:visibility="gone"/>

    </LinearLayout>


    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_marginBottom="@dimen/margin_medium"
        android:textColor="@android:color/white"
        android:textSize="@dimen/tab_menu_text_size"
        />
</LinearLayout>



