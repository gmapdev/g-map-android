<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:fitsSystemWindows = "true"
    >
    <include
        android:id="@+id/rl_header"
        layout="@layout/layout_header"
        />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/accessibility_profile_subtitle"
                android:textColor="@android:color/black"
                android:textSize="@dimen/title_text_size_sp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/accessibility_profile_hint"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/accessibility_profile_first_section_title"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            
            <CheckBox
                android:id="@+id/cb_no_assistive_device"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/no_assistive_device"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <CheckBox
                android:id="@+id/cb_white_cane"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/white_cane"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <CheckBox
                android:id="@+id/cb_manual_walker"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/manual_walker"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <CheckBox
                android:id="@+id/cb_wheeled_walker"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/wheeled_walker"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <CheckBox
                android:id="@+id/cb_cane"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/cane"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <CheckBox
                android:id="@+id/cb_crutches"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/crutches"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />

            <CheckBox
                android:id="@+id/cb_stroller"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/stroller"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <CheckBox
                android:id="@+id/cb_service_animal"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/service_animal"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <CheckBox
                android:id="@+id/cb_mobility_scooter"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/mobility_scooter"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <CheckBox
                android:id="@+id/cb_electric_wheelchair"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/electric_wheelchair"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <CheckBox
                android:id="@+id/cb_manual_traditional_wheelchair"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/manual_traditional_wheelchair"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/accessibility_profile_second_section_title"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <CheckBox
                android:id="@+id/cb_yes"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/yes"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <CheckBox
                android:id="@+id/cb_no"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/no"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/accessibility_profile_third_section_title"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <CheckBox
                android:id="@+id/cb_low_vision"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/low_vision"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <CheckBox
                android:id="@+id/cb_legally_blind"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/legally_blind"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <CheckBox
                android:id="@+id/cb_no_vision_limitations"
                android:minHeight="@dimen/aoda_height"
                android:minWidth="@dimen/aoda_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/no_vision_limitations"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                />
            <TextView
                android:id="@+id/tv_save_preferences"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:padding="@dimen/padding_medium"
                android:minWidth="@dimen/aoda_width"
                android:minHeight="@dimen/aoda_height"
                android:gravity="center"
                android:background="@drawable/rounded_primary_bg"
                android:text="@string/save_preferences"
                android:textColor="@android:color/white"
                android:textSize="@dimen/content_text_size"/>
        </LinearLayout>

    </ScrollView>

    <TextView
        android:id="@+id/tv_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium"
        android:minWidth="@dimen/aoda_width"
        android:minHeight="@dimen/aoda_height"
        android:gravity="center"
        android:background="@drawable/rounded_primary_bg"
        android:text="@string/next"
        android:textColor="@android:color/white"
        android:textSize="@dimen/content_text_size"/>
</LinearLayout>

