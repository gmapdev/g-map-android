<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    >

    <TextView
        android:id="@+id/tv_arrival_time"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_gravity="center_vertical"
        android:gravity="end"
        android:text="1:56 pm"
        android:textColor="@android:color/black"
        android:textSize="@dimen/layer_text_size"
        android:textStyle="bold"/>

    <RelativeLayout
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        >

        <ImageView
            android:id="@+id/iv_upper_highlight"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/black_circle_bg"
             />

        <ImageView
            android:id="@+id/iv_center_highlight"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="9dp"
            android:layout_centerHorizontal="true"
            />
        <ImageView
            android:id="@+id/iv_bottom_highlight"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="18dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/black_circle_bg"
            />

        <ImageView
            android:id="@+id/iv_upper_line"
            android:layout_width="@dimen/margin_small"
            android:layout_height="18dp"
            android:layout_centerHorizontal="true"
            android:background="@android:color/black"
            />

        <ImageView
            android:id="@+id/iv_bottom_line"
            android:layout_below="@+id/iv_upper_line"
            android:layout_width="@dimen/margin_small"
            android:layout_height="18dp"
            android:layout_centerHorizontal="true"
            android:background="@android:color/black"
            />

        <ImageView
            android:layout_width="@dimen/small_icon_size"
            android:layout_height="@dimen/small_icon_size"
            android:layout_centerInParent="true"
            android:background="@drawable/black_circle_bg"
            />
    </RelativeLayout>

    <TextView
        android:id="@+id/tv_stop_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="WEST END STATION"
        android:textColor="@android:color/black"
        android:textSize="@dimen/content_text_size"
        />

    <TextView
        android:id="@+id/tv_stop_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_small"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_gravity="center_vertical"
        android:text="@string/view"
        android:textColor="@android:color/black"
        android:textSize="@dimen/layer_text_size"
        android:background="@drawable/grey_frame_rounded_transparent_bg"
        />
</LinearLayout>
