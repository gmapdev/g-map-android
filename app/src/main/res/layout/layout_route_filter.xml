<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:background="@color/colorHalfTransparent"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_white_with_shadow_bg"
        android:backgroundTint="@color/colorFilterBackground"
        android:layout_margin="@dimen/margin_large"
        android:paddingTop="@dimen/padding_large"
        android:paddingStart="@dimen/padding_large"
        android:paddingEnd="@dimen/padding_large"
        android:layout_centerInParent="true"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/agency"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:textSize="@dimen/content_text_size"
            />

        <LinearLayout
            android:id="@+id/ll_route_filter_agency_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="horizontal"
            android:paddingTop="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_medium"
            android:paddingStart="@dimen/padding_large"
            android:paddingEnd="@dimen/padding_large"
            android:background="@drawable/rounded_white_with_shadow_bg"
            >
            <TextView
                android:id="@+id/tv_route_filter_agency_selection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="@string/all_agencies"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size"
                />
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_sortdown"
                android:layout_gravity="center_vertical"
                />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:text="@string/modes"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:textSize="@dimen/content_text_size"
            />
        <LinearLayout
            android:id="@+id/ll_route_filter_mode_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="horizontal"
            android:paddingTop="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_medium"
            android:paddingStart="@dimen/padding_large"
            android:paddingEnd="@dimen/padding_large"
            android:background="@drawable/rounded_white_with_shadow_bg"
            >
            <TextView
                android:id="@+id/tv_route_filter_mode_selection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="@string/all_modes"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size"
                />
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_sortdown"
                android:layout_gravity="center_vertical"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:orientation="horizontal"
            >
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/tv_route_filter_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/aoda_width"
                android:minHeight="@dimen/aoda_height"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:layout_marginBottom="@dimen/margin_small"
                android:text="@string/cancel"
                android:textSize="@dimen/content_text_size"
                android:textColor="@android:color/black"
                android:textStyle="bold"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/tv_route_filter_save"
                android:layout_width="@dimen/aoda_width"
                android:layout_height="@dimen/aoda_height"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:layout_marginBottom="@dimen/margin_small"
                android:text="@string/save"
                android:textSize="@dimen/content_text_size"
                android:textColor="@android:color/black"
                android:textStyle="bold"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>

