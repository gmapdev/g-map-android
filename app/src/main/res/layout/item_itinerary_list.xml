<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="@dimen/padding_medium"
    android:background="@drawable/rounded_white_with_shadow_bg"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/margin_small"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_modes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textSize="@dimen/itinerary_list_text_size_sp"
            android:accessibilityHeading="true"
            tools:targetApi="p"
            android:textColor="@android:color/black"
            android:text=""
            android:textStyle="bold"
            />
        <LinearLayout
            android:id="@+id/ll_modes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:orientation="horizontal">
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_itinerary_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/iv_itinerary_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_walk"
                android:layout_gravity="center_vertical"
                />

            <TextView
                android:id="@+id/tv_walk_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_gravity="bottom"
                android:textSize="@dimen/content_text_size_sp"
                android:textColor="@color/colorItineraryGrey"
                android:text="16 min"
                />

        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="29dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_clock"
                />
            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:textSize="@dimen/address_input_text_size_sp"
                android:textColor="@android:color/black"
                android:text="39 min"
                android:textStyle="bold"
                />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_start_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:textSize="@dimen/content_text_size_sp"
            android:textColor="@color/colorItineraryGrey"
            android:text="8:16 pm - 9:16pm"
            />

        <LinearLayout
            android:id="@+id/ll_itinerary_cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textSize="@dimen/content_text_size_sp"
                android:textColor="@color/colorItineraryGrey"
                android:text="0.00"
                />
        </LinearLayout>


    </LinearLayout>

</LinearLayout>
