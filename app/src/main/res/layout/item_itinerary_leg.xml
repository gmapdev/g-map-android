<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iv_itinerary_leg_start"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="centerInside"
                app:tint="@android:color/black"
                />
            <ImageView
                android:id="@+id/iv_itinerary_leg_polyline"
                android:layout_width="8dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="@dimen/margin_extra_large"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/vertical_dash_line_bg"
                android:backgroundTint="@color/colorPrimary"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:orientation="horizontal"
                >
                <TextView
                    android:id="@+id/tv_itinerary_leg_start_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/content_text_size_sp"
                    android:textColor="@android:color/black"
                    android:text="City of Atlanta, GA, USA"
                    android:accessibilityHeading="true"
                    tools:targetApi="p"
                    android:textStyle="bold"
                    android:focusableInTouchMode="true"
                    />
                <TextView
                    android:id="@+id/tv_itinerary_leg_start_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/address_list_view_text_size_sp"
                    android:textColor="@color/colorItineraryGrey"
                    android:text="11:08 am"
                    android:gravity="top"
                    android:layout_gravity="top"
                    android:foreground="@drawable/red_strikethrough"
                    android:foregroundTint="@color/colorItineraryEarly"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_time_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:orientation="horizontal"
                >
                <TextView
                    android:id="@+id/tv_time_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/address_list_view_text_size_sp"
                    android:textColor="@color/colorItineraryEarly"
                    android:text="3 min early"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    />
                <TextView
                    android:id="@+id/tv_real_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/address_list_view_text_size_sp"
                    android:textColor="@color/colorItineraryEarly"
                    android:text="11:05 am"
                    android:gravity="center_vertical"
                    android:textStyle="bold"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_itinerary_leg_stop_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:layout_marginTop="6dp"

                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_itinerary_leg_stop_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/address_list_view_text_size_sp"
                    android:textColor="@color/colorItineraryGrey"
                    android:text="Stop ID 908959"
                    android:layout_gravity="start"
                    />

                <TextView
                    android:layout_width="2dp"
                    android:layout_height="@dimen/marker_view_divider_height"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_marginTop="2dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/colorItineraryGrey"
                    />
                <TextView
                    android:id="@+id/tv_itinerary_leg_stop_viewer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:textSize="@dimen/address_list_view_text_size_sp"
                    android:textColor="@color/colorStopViewerButtonBlue"
                    android:text="@string/stop_viewer"
                    android:gravity="top"
                    android:layout_gravity="start"
                    />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:background="@drawable/black_circle_bg"
                    android:padding="@dimen/padding_very_small"
                    android:src="@drawable/ic_walk"
                    android:tint="@color/white"
                    app:tint="@color/white"
                    android:layout_marginEnd="@dimen/padding_small"
                    android:visibility="gone"/>


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/padding_small"
                    android:paddingBottom="@dimen/padding_small"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/view_route_number_header"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:background="@drawable/top_rounded_white_bg"
                        android:visibility="gone"
                        android:backgroundTint="#000000"
                        />

                    <TextView
                        android:id="@+id/tv_itinerary_leg_route_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/padding_medium"
                        android:paddingEnd="@dimen/padding_medium"
                        android:paddingTop="@dimen/padding_small"
                        android:paddingBottom="@dimen/padding_small"
                        android:maxWidth="126dp"
                        android:text="1-line"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/address_list_view_text_size_sp"
                        android:textStyle="bold"
                        android:background="@drawable/bottom_rounded_white_bg"
                        android:backgroundTint="#D9D9D9"/>

<!--                    <TextView-->
<!--                        android:id="@+id/tv_itinerary_leg_route_number"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:paddingStart="@dimen/padding_medium"-->
<!--                        android:paddingEnd="@dimen/padding_medium"-->
<!--                        android:paddingTop="@dimen/padding_small"-->
<!--                        android:paddingBottom="@dimen/padding_small"-->
<!--                        android:maxWidth="126dp"-->
<!--                        android:text="1-line"-->
<!--                        android:textColor="@android:color/black"-->
<!--                        android:textSize="@dimen/address_list_view_text_size_sp"-->
<!--                        android:textStyle="bold"-->
<!--                        android:background="@drawable/bottom_rounded_white_with_shadow_bg"-->
<!--                        android:backgroundTint="#D9D9D9"/>-->

<!--                    <TextView-->
<!--                        android:id="@+id/tv_itinerary_leg_route_number"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:paddingStart="@dimen/padding_medium"-->
<!--                        android:paddingEnd="@dimen/padding_medium"-->
<!--                        android:paddingTop="@dimen/padding_small"-->
<!--                        android:paddingBottom="@dimen/padding_small"-->
<!--                        android:maxWidth="126dp"-->
<!--                        android:text="1-line"-->
<!--                        android:textColor="@android:color/white"-->
<!--                        android:textSize="@dimen/address_list_view_text_size_sp"-->
<!--                        android:textStyle="bold"-->
<!--                        android:background="@drawable/rounded_primary_with_shadow_bg"-->
<!--                        android:backgroundTint="@color/colorItineraryRouteNumberBg"/>-->


                </LinearLayout>


                <LinearLayout
                    android:id="@+id/ll_itinerary_detail_accessible"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:background="@drawable/black_frame_rounded_accessible_bg"
                    android:padding="@dimen/padding_small"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:layout_marginTop="@dimen/margin_medium"

                    >

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_wheelchair"/>
                    <ImageView
                        android:id="@+id/iv_itinerary_detail_accessible_status"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_like"
                        android:layout_marginStart="2dp"/>


                </LinearLayout>


                <TextView
                    android:id="@+id/tv_itinerary_leg_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_small"
                    android:paddingBottom="@dimen/padding_medium"
                    android:lineSpacingExtra="3dp"
                    android:textSize="@dimen/address_list_view_text_size_sp"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/colorItineraryGrey"
                    android:text="Walk 461 feet to corner of sidewalk and Flowers Place Northwest,"
                    />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_itinerary_leg_service_provider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:textSize="@dimen/address_list_view_text_size_sp"
                android:textColor="@color/colorItineraryGrey"
                android:text="@string/subway_route_provider"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                />
            
            <LinearLayout
                android:id="@+id/ll_service_alerts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="horizontal">
                
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_service_alert"
                    android:layout_gravity="center_vertical"/>
                
                <TextView
                    android:id="@+id/tv_service_alerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 alert"
                    android:textColor="@android:color/holo_red_dark"
                    android:textSize="@dimen/content_text_size_sp"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_gravity="center_vertical"/>
                
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="@dimen/margin_small"
                    android:src="@drawable/ic_link"
                    android:layout_gravity="center_vertical"/>
                
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_itinerary_leg_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:id="@+id/ll_itinerary_leg_steps_controller"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingEnd="@dimen/padding_small"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_itinerary_leg_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="150dp"
                        android:layout_gravity="center_vertical"
                        android:textSize="@dimen/address_list_view_text_size_sp"
                        android:textColor="@color/colorItineraryGrey"
                        android:text="2 min"

                        />

                    <TextView
                        android:id="@+id/tv_itinerary_leg_trip_viewer_divider"
                        android:layout_width="2dp"
                        android:layout_height="@dimen/marker_view_divider_height"
                        android:layout_marginStart="@dimen/margin_small"
                        android:layout_gravity="center_vertical"
                        android:background="@color/colorItineraryGrey"
                        />

                    <TextView
                        android:id="@+id/tv_itinerary_leg_trip_viewer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:textSize="@dimen/address_list_view_text_size_sp"
                        android:textColor="@color/colorPrimary"
                        android:text="@string/trip_viewer"

                        />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_itinerary_leg_steps_controller"
                    android:layout_width="@dimen/icon_width"
                    android:layout_height="@dimen/icon_height"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_down"
                    android:scaleType="center"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_itinerary_leg_steps_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_medium"
                android:layout_marginEnd="@dimen/margin_small"
                android:visibility="gone"
                android:orientation="vertical">

            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/ll_itinerary_leg_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_itinerary_leg_end"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="@dimen/padding_medium"
            android:src="@drawable/ic_to"
            android:background="@drawable/ic_layer_bkg_default"
            />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_small">
            <TextView
                android:id="@+id/tv_itinerary_leg_end_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/content_text_size_sp"
                android:textColor="@android:color/black"
                android:text="Atlanta, GA, USA"
                android:accessibilityHeading="true"
                tools:targetApi="p"
                android:textStyle="bold"
                android:focusableInTouchMode="true"
                />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_itinerary_leg_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:text="11:16 am"
            android:textColor="@color/colorItineraryGrey"
            android:textSize="@dimen/address_list_view_text_size_sp" />

    </LinearLayout>
</LinearLayout>