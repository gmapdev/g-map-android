<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/rounded_white_bg"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:orientation="horizontal"
        >

        <TextView
            android:id="@+id/tv_trip_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="15dp"
            android:accessibilityHeading="true"
            android:textColor="@android:color/black"
            android:textSize="@dimen/title_text_size_sp"
            android:textStyle="bold"
            tools:targetApi="p" />
        <LinearLayout
            android:id="@+id/ll_modes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_medium"
            android:orientation="horizontal"
            />
    </LinearLayout>

  <!--  <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        tools:ignore="MissingConstraints"
        >
    </androidx.constraintlayout.widget.ConstraintLayout> -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:orientation="horizontal"
        >
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.35"
            android:layout_marginStart="@dimen/margin_medium"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="@dimen/medium_icon_width"
                    android:layout_height="@dimen/medium_icon_height"
                    android:padding="@dimen/padding_small"
                    android:src="@drawable/ic_start_trip"
                    />
                <TextView
                    android:id="@+id/tv_trip_from"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:textSize="@dimen/content_text_size_sp"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="@dimen/medium_icon_width"
                    android:layout_height="@dimen/medium_icon_height"
                    android:padding="@dimen/padding_small"
                    android:src="@drawable/ic_to"
                    />
                <TextView
                    android:id="@+id/tv_trip_to"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:textSize="@dimen/content_text_size_sp"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="@dimen/medium_icon_width"
                    android:layout_height="@dimen/medium_icon_height"
                    android:padding="@dimen/padding_small"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_my_trip_alert"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:id="@+id/tv_notifications_leading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/content_text_size_sp"
                        android:textColor="@android:color/black"
                        />
                    <TextView
                        android:id="@+id/tv_notifications_leading_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/content_text_size_sp"
                        android:textColor="@color/colorGrey"
                        android:text="@string/before_scheduled_departure"
                        />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="@dimen/medium_icon_width"
                    android:layout_height="@dimen/medium_icon_height"
                    android:padding="@dimen/padding_small"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_my_trip_schedule"
                    />
                <TextView
                    android:id="@+id/tv_happens_on_dates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:textSize="@dimen/content_text_size_sp"
                    android:textColor="@android:color/black"
                    />
            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.15"
            android:layout_marginEnd="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginStart="@dimen/margin_medium"
            android:orientation="vertical"
            android:gravity="end"

            >
            <TextView
                android:id="@+id/tv_itinerary_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/content_text_size_sp"
                android:textColor="@android:color/black"
                android:gravity="start"

                />

            <TextView
                android:id="@+id/tv_itinerary_start_end_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/content_text_size_sp"
                android:textColor="@color/colorGrey"

                />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_medium"
        android:background="@color/colorGrey"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >

        <LinearLayout
            android:id="@+id/ll_pause_resume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_medium"
            android:orientation="vertical"
            android:contentDescription="@string/pause"
            >
            <ImageView
                android:id="@+id/iv_pause_resume"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/btn_pause"
                />
            <TextView
                android:id="@+id/tv_pause_resume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/notification_for_trip"
                android:textColor="@color/colorBlack"
                android:textStyle="bold"
                android:textSize="@dimen/leave_now_text_size_sp"
                />
        </LinearLayout>
        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginBottom="@dimen/margin_medium"
            android:background="@color/colorGrey"
            />
        <LinearLayout
            android:id="@+id/ll_edit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_medium"
            android:orientation="vertical"
            android:contentDescription="@string/edit"
            >
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/btn_edit"
                />
            <TextView
                android:id="@+id/tv_edit_trip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/edit"
                android:textColor="@color/colorBlack"
                android:textStyle="bold"
                android:textSize="@dimen/leave_now_text_size_sp"
                />
        </LinearLayout>
        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginBottom="@dimen/margin_medium"
            android:background="@color/colorGrey"
            />
        <LinearLayout
            android:id="@+id/ll_start_trip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_medium"
            android:orientation="vertical"
            android:contentDescription="@string/edit"
            >
            <ImageView
                android:id="@+id/iv_start_trip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/btn_navigate"
                />
            <TextView
                android:id="@+id/tv_start_trip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/start_trip"
                android:textColor="@color/colorBlack"
                android:textStyle="bold"
                android:textSize="@dimen/leave_now_text_size_sp"
                />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_start_trip_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginBottom="@dimen/margin_medium"
            android:background="@color/colorGrey"
            />
        <LinearLayout
            android:id="@+id/ll_preview_trip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_medium"
            android:orientation="vertical"
            android:contentDescription="@string/edit"
            >
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_preview_trip"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/preview_trip"
                android:textColor="@color/colorBlack"
                android:textStyle="bold"
                android:textSize="@dimen/leave_now_text_size_sp"
                />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_preview_trip_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginBottom="@dimen/margin_medium"
            android:background="@color/colorGrey"
            />
        <LinearLayout
            android:id="@+id/ll_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_medium"
            android:orientation="vertical"
            android:contentDescription="@string/delete"
            >
            <ImageView
                android:id="@+id/iv_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/btn_delete"
                />
            <TextView
                android:id="@+id/tv_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/delete"
                android:textColor="@color/colorBlack"
                android:textStyle="bold"
                android:textSize="@dimen/leave_now_text_size_sp"
                />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>