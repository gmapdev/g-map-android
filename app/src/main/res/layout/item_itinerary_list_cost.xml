<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">
    <TextView
        android:id="@+id/tv_divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/colorGrey"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_itinerary_highlight"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/colorItineraryHighlight"
            />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="@dimen/margin_medium"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_modes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:textSize="@dimen/address_input_text_size"
                        android:accessibilityHeading="true"
                        tools:targetApi="p"
                        android:textColor="@android:color/black"
                        android:text=""
                        android:textStyle="bold"
                        />
                    <LinearLayout
                        android:id="@+id/ll_modes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:orientation="horizontal">
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_cost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/address_input_text_size"
                        android:textColor="@android:color/black"
                        android:text="$0.00"
                        android:textStyle="bold"
                        />

                    <TextView
                        android:id="@+id/tv_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/layer_text_size"
                        android:textColor="@android:color/black"
                        android:text="39 min"
                        />
                    <TextView
                        android:id="@+id/tv_start_end_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/layer_text_size"
                        android:textColor="@android:color/black"
                        android:text="8:16 pm - 9:16pm"
                        />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tv_walk_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:textSize="@dimen/layer_text_size"
                            android:textColor="@android:color/black"
                            android:text="16 min"
                            />
                        <ImageView
                            android:id="@+id/iv_itinerary_mode"
                            android:layout_marginStart="@dimen/margin_small"
                            android:layout_width="@dimen/layer_icon_size"
                            android:layout_height="@dimen/layer_icon_size"
                            android:src="@drawable/ic_walk"
                            />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_click_view_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textSize="@dimen/layer_text_size"
                android:textColor="@color/colorGrey"
                android:text="@string/click_view_details"
                />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>