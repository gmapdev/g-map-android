<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >
    <LinearLayout
        android:id="@+id/ll_route_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <LinearLayout
            android:id="@+id/ll_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <com.android.volley.toolbox.NetworkImageView
                android:id="@+id/iv_route_logo"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_gravity="center_vertical"
                />
            <ImageView
                android:id="@+id/iv_route_type"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/margin_medium"
                android:src="@drawable/ic_bus"
                app:tint="@android:color/black"
                />
            <TextView
                android:id="@+id/tv_route"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/margin_medium"
                android:paddingStart="@dimen/padding_medium"
                android:paddingEnd="@dimen/padding_medium"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:textSize="@dimen/content_text_size_sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:background="@drawable/rounded_dark_grey_bg"/>

            <TextView
                android:id="@+id/tv_route_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/margin_medium"
                android:textSize="@dimen/content_text_size_sp"
                android:textColor="@android:color/black"
                android:maxLines="2"
                android:ellipsize="end"
                />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_route_agency_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_medium"
            android:text="@string/no_route_url_provided"
            android:textSize="@dimen/layer_text_size_sp"
            android:textColor="@android:color/black"/>

        <LinearLayout
            android:id="@+id/ll_route_agency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <TextView
                android:id="@+id/tv_route_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/margin_medium"
                android:text="@string/no_route_url_provided"
                android:textSize="@dimen/layer_text_size_sp"
                android:textColor="@android:color/black"/>
        </LinearLayout>

        <include
            android:id="@+id/ll_route_directions_stops"
            layout="@layout/layout_route_directions_stops"
            android:visibility="gone"
            />
    </LinearLayout>
</RelativeLayout>
