<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/padding_medium"
    android:orientation="horizontal">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_travel_companion"
    	android:layout_gravity="center_vertical"
        app:tint="@color/colorBlack" />

    <TextView
        android:id="@+id/tv_travel_companion_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_gravity="center_vertical"
        android:textColor="@android:color/black"
        android:textSize="@dimen/content_text_size"/>

    <TextView
        android:id="@+id/tv_travel_companion_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_small"
        android:background="@drawable/rounded_primary_bg"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:padding="@dimen/padding_small"

        android:text="@string/verified"
        android:textColor="@android:color/white"
        android:textSize="@dimen/content_text_size_sp" />
    <ImageView
        android:id="@+id/iv_delete_travel_companion"
        android:layout_width="@dimen/aoda_width"
        android:layout_height="@dimen/aoda_height"
        android:padding="@dimen/padding_medium"
        android:layout_marginStart="@dimen/margin_medium"
        android:src="@drawable/ic_delete_travel_companion"
        android:layout_gravity="center_vertical"
        />
</LinearLayout>