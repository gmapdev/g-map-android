<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:background="@color/colorHalfTransparent"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="@dimen/margin_large"

        android:background="@drawable/rounded_white_bg"
        android:orientation="vertical"
        android:padding="@dimen/padding_large">
        <ScrollView
            android:id="@+id/sv_popup_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/ll_popup_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/layer_icon_size"
                        android:layout_height="@dimen/layer_icon_size"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:src="@drawable/ic_indoor_origin" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:text="@string/you_arrive_at"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/content_text_size_sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_indoor_navigation_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/margin_small"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="@dimen/content_text_size_sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/do_you_want_to_open_indoor_navigation"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_indoor_navigation_popup_building"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:text="@string/indoor_navigation_button_hint"
                    android:textSize="@dimen/content_text_size_sp"
                    android:textColor="@color/colorGrey"
                    />
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/tv_indoor_navigation_popup_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/rounded_dark_grey_bg"
                android:gravity="center"
                android:paddingTop="@dimen/padding_medium"
                android:paddingBottom="@dimen/padding_medium"
                android:text="@string/cancel"
                android:textColor="@android:color/white"
                android:textSize="@dimen/content_text_size_sp" />

            <TextView
                android:id="@+id/tv_indoor_navigation_popup_open"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_weight="1"
                android:background="@drawable/rounded_primary_bg"
                android:gravity="center"
                android:paddingTop="@dimen/padding_medium"
                android:paddingBottom="@dimen/padding_medium"
                android:text="@string/open"
                android:textColor="@android:color/white"
                android:textSize="@dimen/content_text_size_sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
