<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/padding_small"
    android:paddingTop="@dimen/padding_small"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/iv_fav_stop_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_stops"
    	android:layout_gravity="center_vertical"
        app:tint="@color/colorGrey" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/margin_small"
        android:orientation="vertical"
        >
        <TextView
            android:id="@+id/tv_stop_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@android:color/black"
            android:textSize="@dimen/content_text_size"/>
        <TextView
            android:id="@+id/tv_stop_id"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/colorGrey"
            android:textSize="@dimen/address_list_view_text_size"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_stop_fav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_saved"
        android:layout_gravity="center_vertical"
        />
</LinearLayout>