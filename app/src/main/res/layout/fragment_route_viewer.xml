<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".fragment.RouteViewerFragment">

    <com.mapbox.mapboxsdk.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RelativeLayout
        android:id="@+id/rl_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_white_with_shadow_bg"
            android:orientation="horizontal"

            >
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/margin_medium"

                android:src="@drawable/ic_search"
                />
            <TextView
                android:id="@+id/tv_search_a_route"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/margin_medium"
                android:contentDescription=" "
                android:maxLines="4"
                android:hint="@string/search_for_a_route"
                android:textColorHint="@color/colorHintText"
                android:background="@android:color/transparent"
                android:textSize="@dimen/address_input_text_size_sp"
                android:ellipsize="end"
                />

            <ImageView
                android:id="@+id/iv_collapse"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center_vertical"
                android:layout_alignParentEnd="true"
                android:scaleType="centerInside"
                android:src="@drawable/btn_collapse"
                android:contentDescription="@string/search_bar_collapse_button"
                />
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_filter_changed"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_circle"
            app:tint="@color/colorSettingsChanged"
            android:visibility="gone"
            />
    </RelativeLayout>



    <RelativeLayout
        android:id="@+id/rl_collapsed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium"
        android:layout_below="@+id/rl_search_bar"
        android:visibility="gone"
        >
        <ImageView
            android:id="@+id/iv_collapsed_back"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_vertical"
            android:scaleType="centerInside"
            android:src="@drawable/ic_leftarrow"
            android:background="@drawable/ic_layer_bkg_default"
            android:contentDescription="@string/search_bar_back_button"
            />

        <ImageView
            android:id="@+id/iv_expand"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:scaleType="centerInside"
            android:src="@drawable/btn_expand"
            android:background="@drawable/ic_layer_bkg_default"
            android:contentDescription="@string/search_bar_expand_button"
            />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_layer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_collapsed"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/margin_medium"
        android:contentDescription="@string/map_settings"
        >
        <ImageView
            android:id="@+id/iv_layer_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_layer_bkg_default"
            />
        <ImageView
            android:id="@+id/iv_layer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_layer"
            />
    </RelativeLayout>

    <include
        android:id="@+id/ll_route_viewer"
        layout="@layout/layout_route_viewer"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_alignParentBottom="true" />

    <include
        android:id="@+id/ll_layout_layers"
        layout="@layout/layout_layers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:visibility="gone"
        />

</RelativeLayout>