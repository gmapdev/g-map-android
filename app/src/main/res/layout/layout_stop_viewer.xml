<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium"
        android:background="@color/colorGrey"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_stop_viewer_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:textColor="@android:color/black"
            android:textSize="@dimen/title_text_size"
            android:accessibilityHeading="true"
            tools:targetApi="p"
            android:textStyle="bold"
            android:text="JOSEPH E BOONE BLVD @ ANDREW J HAIRSTON BLVD"/>
        <ImageView
            android:id="@+id/iv_stop_viewer_save"
            android:layout_width="@dimen/icon_width"
            android:layout_height="@dimen/icon_width"
            android:padding="15dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ic_star"
            />
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        >
        <TextView
            android:id="@+id/tv_stop_viewer_stop_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="@string/bold_stop_id_with_num"
            android:textColor="@android:color/black"
            android:textSize="@dimen/layer_text_size"/>

        <LinearLayout
            android:id="@+id/ll_schedule_arrivals_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            >
            <ImageView
                android:id="@+id/iv_schedule_arrivals_switch"
                android:layout_width="@dimen/layer_icon_size"
                android:layout_height="@dimen/layer_icon_size"
                android:padding="@dimen/padding_small"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_calendar_search"
                />
            <TextView
                android:id="@+id/tv_schedule_arrivals_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/view_schedule"
                android:textColor="@color/colorStopViewerBlue"
                android:textSize="@dimen/layer_text_size"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/plan_a_trip"
            android:textColor="@android:color/black"
            android:textSize="@dimen/layer_text_size"
            android:textStyle="bold"/>
        <ImageView
            android:layout_width="@dimen/layer_icon_size"
            android:layout_height="@dimen/layer_icon_size"
            android:padding="@dimen/padding_small"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_start_trip"
            />
        <TextView
            android:id="@+id/tv_stop_viewer_from_here"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingTop="@dimen/padding_small"
            android:paddingBottom="@dimen/padding_small"
            android:text="@string/from_here"
            android:textColor="@color/colorStopViewerBlue"
            android:textSize="@dimen/layer_text_size"/>

        <TextView
            android:layout_width="2dp"
            android:layout_height="@dimen/marker_view_divider_height"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_gravity="center_vertical"
            android:background="@android:color/black"
            />
        <ImageView
            android:layout_width="@dimen/layer_icon_size"
            android:layout_height="@dimen/layer_icon_size"
            android:layout_gravity="center_vertical"
            android:padding="@dimen/padding_small"
            android:src="@drawable/ic_end"
            />

        <TextView
            android:id="@+id/tv_stop_viewer_to_here"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingTop="@dimen/padding_small"
            android:paddingBottom="@dimen/padding_small"
            android:text="@string/to_here"
            android:textColor="@color/colorStopViewerBlue"
            android:textSize="@dimen/layer_text_size"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_stop_viewer_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_gravity="end"
        android:orientation="horizontal"
        >
        <TextView
            android:id="@+id/tv_stop_viewer_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="2021-07-02"
            android:textColor="@android:color/black"
            android:textSize="@dimen/layer_text_size"/>

        <ImageView
            android:layout_width="@dimen/layer_icon_size"
            android:layout_height="@dimen/layer_icon_size"
            android:padding="@dimen/padding_small"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_calendar_plan"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        android:paddingTop="@dimen/padding_small"
        android:paddingBottom="@dimen/padding_small"
        android:gravity="center_horizontal"
        android:background="@drawable/rounded_departure_times_info_bg"
        android:orientation="horizontal"
        >
        <ImageView
            android:layout_width="@dimen/layer_icon_size"
            android:layout_height="@dimen/layer_icon_size"
            android:padding="@dimen/padding_small"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_info"
            app:tint="@color/colorDepartureTimesInfoText" />
        <TextView
            android:id="@+id/tv_departure_time_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/departure_time_info"
            android:textColor="@color/colorDepartureTimesInfoText"
            android:textSize="@dimen/layer_text_size"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/sv_stop_viewer_arrivals"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/margin_medium"
            android:orientation="vertical">

            <ListView
                android:id="@+id/lv_stop_viewer_arrivals_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:divider="@android:color/transparent"
                android:dividerHeight="@dimen/margin_medium"
                />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                >
                <LinearLayout
                    android:id="@+id/ll_stop_viewer_auto_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal"
                    >
                    <CheckBox
                        android:id="@+id/cb_stop_viewer_auto_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:clickable="false"
                        android:buttonTint="@color/colorStopViewerBlue"
                        />
                    <TextView
                        android:id="@+id/tv_stop_viewer_auto_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/auto_refresh_arrivals"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/layer_text_size"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_stop_viewer_refresh_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal"
                    >
                    <ImageView
                        android:id="@+id/iv_stop_viewer_refresh_time"
                        android:layout_width="@dimen/layer_icon_size"
                        android:layout_height="@dimen/layer_icon_size"
                        android:padding="@dimen/padding_small"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/colorStopViewerBlue" />
                    <TextView
                        android:id="@+id/tv_stop_viewer_refresh_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="3:16 pm"
                        android:textColor="@color/colorStopViewerBlue"
                        android:textSize="@dimen/layer_text_size"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/ll_stop_viewer_schedule_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_medium"
        android:orientation="horizontal"
        android:visibility="gone"
        >
        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/route"
            android:textColor="@android:color/black"
            android:textSize="@dimen/stop_viewer_schedule_title_text_size"
            android:accessibilityHeading="true"
            tools:targetApi="p"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:text="@string/to"
            android:textColor="@android:color/black"
            android:textSize="@dimen/stop_viewer_schedule_title_text_size"
            android:accessibilityHeading="true"
            tools:targetApi="p"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/departure"
            android:textColor="@android:color/black"
            android:textSize="@dimen/stop_viewer_schedule_title_text_size"
            android:accessibilityHeading="true"
            tools:targetApi="p"
            android:textStyle="bold"/>
    </LinearLayout>

    <ListView
        android:id="@+id/lv_stop_viewer_schedule"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_marginBottom="@dimen/margin_medium"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:visibility="gone"
        />
</LinearLayout>