<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/padding_medium"
    android:orientation="vertical"
    >

    <TextView
        android:id="@+id/tv_towards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_medium"
        android:text="@string/towards"
        android:textColor="@android:color/black"
        android:textSize="@dimen/layer_text_size_sp"
        android:maxLines="2"/>

    <RelativeLayout
        android:id="@+id/rl_route_directions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/padding_medium">

        <ImageView
            android:id="@+id/iv_route_direction_expander"
            android:layout_width="@dimen/icon_width"
            android:layout_height="@dimen/icon_width"
            android:layout_alignParentEnd="true"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/margin_medium"
            android:scaleType="centerInside"
            android:src="@drawable/ic_down" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_route_direction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_toLeftOf="@+id/iv_route_direction_expander"
            android:layout_marginStart="@dimen/margin_small"
            />

        <GridView
            android:id="@+id/gv_selected_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:clickable="false"
            android:columnWidth="@dimen/margin_medium"
            android:gravity="center_horizontal"
            android:horizontalSpacing="0dp"
            android:layout_below="@+id/vp_route_direction"
            android:stretchMode="spacingWidthUniform"
            android:layout_marginTop="@dimen/margin_small"/>
    </RelativeLayout>

    <ListView
        android:id="@+id/lv_route_direction_stops"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:dividerHeight="0dp"
        android:divider="@android:color/transparent"
        android:visibility="gone"
        />

</LinearLayout>


