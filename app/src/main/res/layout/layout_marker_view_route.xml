<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/rl_maker_view_route"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="15dp"
    android:paddingEnd="15dp"
    android:paddingBottom="@dimen/padding_small"
    android:paddingTop="@dimen/padding_small"
    android:background="@drawable/black_circle_bg"
    android:backgroundTint="@color/defaultMarkerBackground"
    >
    <TextView
        android:id="@+id/tv_maker_view_route"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:maxWidth="86dp"
        android:textColor="@android:color/white"
        android:textSize="@dimen/layer_text_size"/>
</RelativeLayout>

