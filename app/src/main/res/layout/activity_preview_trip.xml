<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows = "true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/aoda_width"
                android:layout_height="@dimen/aoda_height"
                android:layout_margin="@dimen/margin_medium"
                android:scaleType="centerInside"
                android:src="@drawable/ic_leftarrow"
                app:tint="@color/colorBlack"
                android:background="@drawable/ic_layer_bkg_default"
                android:contentDescription="@string/preview_trip_back_button"
                android:layout_centerVertical="true"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preview_trip"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/title_text_size_sp"
                android:layout_centerInParent="true"
                />

            <ImageView
                android:id="@+id/iv_mute"
                android:layout_width="@dimen/aoda_width"
                android:layout_height="@dimen/aoda_height"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/margin_medium"
                android:layout_centerVertical="true"
                android:padding="12dp"
                android:src="@drawable/ic_preview_trip_notification"
                app:tint="@color/colorBlack"
                android:background="@drawable/ic_layer_bkg_default"
                />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/margin_medium"
            android:layout_marginBottom="@dimen/margin_medium"
            android:padding="1dp"
            android:background="@drawable/gray_frame_white_bg"
            >

            <com.mapbox.mapboxsdk.maps.MapView
                android:id="@+id/map_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/ll_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_medium"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/margin_medium"
            android:orientation="horizontal"
            android:visibility="gone"
            >
            <ImageView
                android:id="@+id/iv_previous"
                android:layout_width="@dimen/aoda_width"
                android:layout_height="@dimen/aoda_height"
                android:scaleType="centerInside"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_leftarrow"
                android:background="@drawable/rounded_primary_bg"
                app:tint="@android:color/white"
                android:contentDescription="@string/previous_button"
                />
            <ImageView
                android:id="@+id/iv_instruction"
                android:layout_width="@dimen/aoda_width"
                android:layout_height="@dimen/aoda_height"
                android:padding="@dimen/padding_small"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_indoor_rightturn"
                app:tint="@color/colorBlack"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/margin_small"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_instruction_direction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/content_text_size_sp"
                    android:textStyle="bold"
                    />
                <TextView
                    android:id="@+id/tv_instruction_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/layer_text_size_sp"

                    />

            </LinearLayout>

            <ImageView
                android:id="@+id/iv_next"
                android:layout_width="@dimen/aoda_width"
                android:layout_height="@dimen/aoda_height"
                android:scaleType="centerInside"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_rightarrow"
                android:background="@drawable/rounded_primary_bg"
                app:tint="@android:color/white"
                android:contentDescription="@string/next_button"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_active_route_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/padding_medium"
            android:background="@drawable/top_rounded_white_with_shadow_bg"
            android:orientation="vertical"
            >
            <!-- ListView below the TextViews -->
            <ListView
                android:id="@+id/lv_itinerary_leg_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:maxHeight="100dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_audio_notification_popup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium"
        android:paddingStart="@dimen/padding_medium"
        android:paddingEnd="@dimen/padding_medium"
        android:paddingTop="@dimen/padding_large"
        android:paddingBottom="@dimen/padding_large"
        android:layout_centerInParent="true"
        android:background="@drawable/rounded_primary_bg"
        android:orientation="vertical"
        android:visibility="gone">
        <ImageView
            android:id="@+id/iv_audio_notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_audio_notification"
            android:layout_gravity="center_horizontal"
            />

        <TextView
            android:id="@+id/tv_audio_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:textColor="@color/white"
            android:textSize="@dimen/content_text_size_sp"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:text="@string/audio_notification_off"
            android:textStyle="bold"
            />
    </LinearLayout>
</RelativeLayout>
