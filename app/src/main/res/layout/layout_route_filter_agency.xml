<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:background="@color/colorHalfTransparent"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_white_with_shadow_bg"
        android:layout_margin="@dimen/margin_large"
        android:paddingTop="@dimen/padding_large"
        android:paddingStart="@dimen/padding_large"
        android:paddingEnd="@dimen/padding_large"
        android:layout_centerInParent="true"
        android:orientation="vertical">
        <ListView
            android:id="@+id/lv_route_filter_agency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginBottom="@dimen/margin_small"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            >
            <TextView
                android:id="@+id/tv_route_filter_agency_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/aoda_width"
                android:minHeight="@dimen/aoda_height"
                android:paddingTop="@dimen/padding_small"
                android:paddingBottom="@dimen/padding_small"
                android:paddingStart="@dimen/padding_large"
                android:paddingEnd="@dimen/padding_large"
                android:gravity="center"
                android:text="@string/cancel"
                android:textSize="@dimen/content_text_size_sp"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:background="@drawable/rounded_light_grey_bg"
                />
            <TextView
                android:id="@+id/tv_route_filter_agency_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/aoda_width"
                android:minHeight="@dimen/aoda_height"
                android:paddingTop="@dimen/padding_small"
                android:paddingBottom="@dimen/padding_small"
                android:paddingStart="@dimen/padding_extra_large"
                android:paddingEnd="@dimen/padding_extra_large"
                android:gravity="center"
                android:layout_marginStart="@dimen/margin_medium"
                android:text="@string/ok"
                android:textSize="@dimen/content_text_size_sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:background="@drawable/rounded_primary_with_shadow_bg"
                />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>

