<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >
    <LinearLayout
        android:id="@+id/ll_route_search_address_expanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/rounded_white_with_shadow_bg"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_route_search_bar_back"
            android:layout_width="@dimen/aoda_width"
            android:layout_height="@dimen/aoda_height"

            android:src="@drawable/ic_leftarrow"
            android:scaleType="centerInside"
            android:contentDescription="@string/back_button"
            android:visibility="gone"
            />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_medium"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_route_search_origin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <ImageView
                    android:layout_width="@dimen/medium_icon_width"
                    android:layout_height="@dimen/medium_icon_height"
                    android:layout_gravity="center_vertical"
                    android:padding="@dimen/padding_small"
                    android:src="@drawable/ic_start_trip"
                    />
                <TextView
                    android:id="@+id/tv_route_search_origin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:background="@android:color/transparent"
                    android:textColorHint="@color/colorHintText"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/address_input_text_size_sp"
                    />
                <ImageView
                    android:id="@+id/iv_route_search_address_collapse"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center_vertical"
                    android:scaleType="centerInside"
                    android:src="@drawable/btn_collapse"
                    android:contentDescription="@string/search_bar_collapse_button"
                    />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorGrey"
                android:layout_marginEnd="60dp"
                />

            <LinearLayout
                android:id="@+id/ll_route_search_destination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <ImageView
                    android:layout_width="@dimen/medium_icon_width"
                    android:layout_height="@dimen/medium_icon_height"
                    android:layout_gravity="center_vertical"
                    android:padding="@dimen/padding_small"
                    android:src="@drawable/ic_to"
                    />
                <TextView
                    android:id="@+id/tv_route_search_destination"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"

                    android:gravity="center_vertical"
                    android:background="@android:color/transparent"
                    android:textColorHint="@color/colorHintText"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/address_input_text_size_sp"
                    />
                <ImageView
                    android:id="@+id/iv_route_search_address_switch"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center_vertical"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_switch"
                    />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_route_search_address_collapsed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">
        <ImageView
            android:id="@+id/iv_route_search_address_collapsed_back"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_vertical"
            android:scaleType="centerInside"
            android:src="@drawable/ic_leftarrow"
            android:background="@drawable/ic_layer_bkg_default"
            android:contentDescription="@string/search_bar_back_button"
            />

        <ImageView
            android:id="@+id/iv_route_search_address_collapsed_expand"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:scaleType="centerInside"
            android:src="@drawable/btn_expand"
            android:background="@drawable/ic_layer_bkg_default"
            android:contentDescription="@string/search_bar_expand_button"
            />
    </RelativeLayout>
</RelativeLayout>