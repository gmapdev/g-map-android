<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="@drawable/white_with_shadow_bg"
    android:orientation="horizontal"

    >
    <LinearLayout
        android:id="@+id/ll_tab_menu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/aoda_height"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/iv_tab_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_tab_menu"
            app:tint="@color/tabColorUnselected"
            />
        <TextView
            android:id="@+id/tv_tab_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/menu"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/tabColorUnselected"
            android:textSize="@dimen/layer_text_size_sp"

            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_tab_pan_trip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/aoda_height"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_marginStart="2dp"
        >
        <ImageView
            android:id="@+id/iv_tab_pan_trip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_plantrip"
            app:tint="@color/colorPrimary"
            />
        <TextView
            android:id="@+id/tv_tab_pan_trip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/plan_trip"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/layer_text_size_sp"
            android:maxLines="1"
            android:ellipsize="end"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_tab_routes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/aoda_height"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:layout_marginStart="2dp"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/iv_tab_routes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_routes"
            app:tint="@android:color/black"
            />
        <TextView
            android:id="@+id/tv_tab_routes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/routes"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@android:color/black"
            android:textSize="@dimen/layer_text_size_sp"
            android:paddingStart="3dp"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_tab_stops"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/aoda_height"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginStart="2dp">
        <ImageView
            android:id="@+id/iv_tab_stops"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_stops"
            app:tint="@android:color/black"
            />
        <TextView
            android:id="@+id/tv_tab_stops"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/stops"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@android:color/black"
            android:textSize="@dimen/layer_text_size_sp"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_tab_sign_in"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/aoda_height"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:layout_marginStart="2dp"

        android:orientation="vertical">
        <ImageView
            android:id="@+id/iv_tab_sign_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_signin"
            app:tint="@android:color/black"
            />
        <TextView
            android:id="@+id/tv_tab_sign_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/sign_in"
            android:textColor="@android:color/black"
            android:textSize="@dimen/layer_text_size_sp"
            android:maxLines="1"
            android:ellipsize="end"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_tab_my_trips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/aoda_height"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:orientation="vertical"
        android:layout_marginStart="2dp">
        <ImageView
            android:id="@+id/iv_tab_my_trips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_save"
            app:tint="@android:color/black"
            />
        <TextView
            android:id="@+id/tv_tab_my_trips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/my_trips"
            android:textColor="@android:color/black"
            android:textSize="@dimen/layer_text_size_sp"
            android:maxLines="1"
            android:ellipsize="end"
            />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rl_user_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:visibility="gone"
        >
        <TextView
            android:id="@+id/tv_user_name"
            android:layout_width="@dimen/aoda_width"
            android:layout_height="@dimen/aoda_height"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="IBI"
            android:textColor="@android:color/white"
            android:textSize="@dimen/address_input_text_size_sp"
            android:background="@drawable/ic_circle"
            android:backgroundTint="@color/colorTabUserUnselected"
            android:maxLines="1"

            />
    </RelativeLayout>

</LinearLayout>

