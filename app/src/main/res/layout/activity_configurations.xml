<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="8dp"
    android:filterTouchesWhenObscured="true">
    
    <Button 
		android:id="@+id/btn_back_to_default"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Back_to_Default"
        android:layout_gravity="right"
        android:background="@drawable/rounded_primary_button"
        android:textColor="@drawable/rounded_primary_button"
        android:textAllCaps="false"/>

	<CheckBox
    	android:id="@+id/chckbx_use_prefix"
     	android:layout_width="wrap_content"
     	android:layout_height="wrap_content"
     	android:text="@string/Enable_Simulation_Mode"
        android:textColor="@android:color/black"
        android:buttonTint="@android:color/black"/>
    
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Device_Id"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="@android:color/black"/>
    
    <EditText
        android:id="@+id/txt_device_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/Enter_device_id"
        android:ems="10"
        android:textColor="@android:color/black">
        <requestFocus />
    </EditText>
    
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/device_push_token"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="@android:color/black"/>
    
    <TextView
        android:id="@+id/tv_device_token"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textIsSelectable="true"
        android:textColor="@android:color/darker_gray"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:text="@string/setup_configuration_server"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="@android:color/black"
        android:layout_margin="0dp" />

    <LinearLayout
        android:id="@+id/ll_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:orientation="horizontal"
        >
        <ImageView
            android:id="@+id/iv_default"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_popup_saved"
            android:layout_gravity="center_vertical"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_small"
            android:orientation="vertical"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_title"
                android:textColor="@android:color/black"
                android:textAppearance="?android:attr/textAppearanceMedium"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_value"
                android:textColor="@android:color/darker_gray"
                />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_production"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:orientation="horizontal"
        >
        <ImageView
            android:id="@+id/iv_production"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_popup_saved"
            android:layout_gravity="center_vertical"
            android:visibility="invisible"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_small"
            android:orientation="vertical"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/production_title"
                android:textColor="@android:color/black"
                android:textAppearance="?android:attr/textAppearanceMedium"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/production_value"
                android:textColor="@android:color/darker_gray"
                />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_staging"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:orientation="horizontal"
        >
        <ImageView
            android:id="@+id/iv_staging"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_popup_saved"
            android:layout_gravity="center_vertical"
            android:visibility="invisible"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_small"
            android:orientation="vertical"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/staging_title"
                android:textColor="@android:color/black"
                android:textAppearance="?android:attr/textAppearanceMedium"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/staging_value"
                android:textColor="@android:color/darker_gray"
                />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>