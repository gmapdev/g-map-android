<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:background="@android:color/white">
    <include
        android:id="@+id/rl_header"
        layout="@layout/layout_header"
        />

    <ScrollView
        android:id="@+id/sv_edit_trip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:text="@string/field_mask_asterisk_required"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/trip_information"
                android:textColor="@android:color/black"
                android:textSize="@dimen/address_input_text_size_sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/select_itinerary"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_itinerary_start_end_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp" />

                <TextView
                    android:id="@+id/tv_itinerary_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_modes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="horizontal" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_modes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                tools:ignore="MissingConstraints">
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_trip_name_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="@string/name_trip"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginStart="@dimen/margin_small"
                    android:text="*"
                    android:textColor="@android:color/holo_red_dark"
                    android:textSize="@dimen/title_text_size"
                    android:textStyle="bold"/>
            </LinearLayout>


            <EditText
                android:id="@+id/et_trip_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:background="@drawable/grey_frame_rounded_white_bg"
                android:padding="@dimen/padding_small" />

            <TextView
                android:id="@+id/tv_trip_name_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginBottom="@dimen/margin_medium"
                android:text="@string/please_enter_a_trip_name"
                android:textColor="@color/colorGrey"
                android:textSize="@dimen/content_text_size_sp"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trip_days"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginStart="@dimen/margin_small"
                    android:text="*"
                    android:textColor="@android:color/holo_red_dark"
                    android:textSize="@dimen/title_text_size"
                    android:textStyle="bold"/>
            </LinearLayout>
            <RadioButton
                android:id="@+id/rb_each_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/on_certain_days_each_week"
                android:textColor="@android:color/black"
                android:textSize="@dimen/address_list_view_text_size_sp"
                android:buttonTint="@color/colorValidDateBg"
                android:checked="true"/>

            <LinearLayout
                android:id="@+id/ll_each_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:background="@drawable/grey_frame_white_bg"
                android:padding="1dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll_monday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_monday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/margin_small"
                        android:text="@string/mon"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/layer_text_size_sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <CheckBox
                        android:id="@+id/cb_monday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:clickable="false"
                        android:foregroundTint="@android:color/white" />
                    <ImageView
                        android:id="@+id/iv_monday"
                        android:layout_width="@dimen/stop_marker_icon_size"
                        android:layout_height="@dimen/stop_marker_icon_size"
                        android:layout_gravity="center_horizontal"
                        android:layout_margin="8dp"
                        android:src="@drawable/ic_unavailable" />
                </LinearLayout>

                <TextView
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/colorLightGrey" />

                <LinearLayout
                    android:id="@+id/ll_tuesday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_tuesday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/margin_small"
                        android:text="@string/tue"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/layer_text_size_sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <CheckBox
                        android:id="@+id/cb_tuesday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:foregroundTint="@android:color/white"
                        android:clickable="false" />
                    <ImageView
                        android:id="@+id/iv_tuesday"
                        android:layout_width="@dimen/stop_marker_icon_size"
                        android:layout_height="@dimen/stop_marker_icon_size"
                        android:layout_gravity="center_horizontal"
                        android:layout_margin="8dp"
                        android:src="@drawable/ic_unavailable" />
                </LinearLayout>

                <TextView
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/colorLightGrey" />

                <LinearLayout
                    android:id="@+id/ll_wednesday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_wednesday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/margin_small"
                        android:text="@string/wed"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/layer_text_size_sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <CheckBox
                        android:id="@+id/cb_wednesday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:foregroundTint="@android:color/white"
                        android:clickable="false" />
                    <ImageView
                        android:id="@+id/iv_wednesday"
                        android:layout_width="@dimen/stop_marker_icon_size"
                        android:layout_height="@dimen/stop_marker_icon_size"
                        android:layout_gravity="center_horizontal"
                        android:layout_margin="8dp"
                        android:src="@drawable/ic_unavailable" />
                </LinearLayout>

                <TextView
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/colorLightGrey" />

                <LinearLayout
                    android:id="@+id/ll_thursday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_thursday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/margin_small"
                        android:text="@string/thu"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/layer_text_size_sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <CheckBox
                        android:id="@+id/cb_thursday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:foregroundTint="@android:color/white"
                        android:clickable="false" />
                    <ImageView
                        android:id="@+id/iv_thursday"
                        android:layout_width="@dimen/stop_marker_icon_size"
                        android:layout_height="@dimen/stop_marker_icon_size"
                        android:layout_gravity="center_horizontal"
                        android:layout_margin="8dp"
                        android:src="@drawable/ic_unavailable" />
                </LinearLayout>

                <TextView
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/colorLightGrey" />

                <LinearLayout
                    android:id="@+id/ll_friday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_friday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/margin_small"
                        android:text="@string/fri"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/layer_text_size_sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <CheckBox
                        android:id="@+id/cb_friday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:foregroundTint="@android:color/white"
                        android:clickable="false" />
                    <ImageView
                        android:id="@+id/iv_friday"
                        android:layout_width="@dimen/stop_marker_icon_size"
                        android:layout_height="@dimen/stop_marker_icon_size"
                        android:layout_gravity="center_horizontal"
                        android:layout_margin="8dp"
                        android:src="@drawable/ic_unavailable" />
                </LinearLayout>

                <TextView
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/colorLightGrey" />

                <LinearLayout
                    android:id="@+id/ll_saturday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_saturday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/margin_small"
                        android:text="@string/sat"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/layer_text_size_sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <CheckBox
                        android:id="@+id/cb_saturday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:foregroundTint="@android:color/white"
                        android:clickable="false" />
                    <ImageView
                        android:id="@+id/iv_saturday"
                        android:layout_width="@dimen/stop_marker_icon_size"
                        android:layout_height="@dimen/stop_marker_icon_size"
                        android:layout_gravity="center_horizontal"
                        android:layout_margin="8dp"
                        android:src="@drawable/ic_unavailable" />
                </LinearLayout>

                <TextView
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/colorLightGrey" />

                <LinearLayout
                    android:id="@+id/ll_sunday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_sunday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/margin_small"
                        android:text="@string/sun"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/layer_text_size_sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <CheckBox
                        android:id="@+id/cb_sunday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:clickable="false"
                        android:foregroundTint="@android:color/white" />

                    <ImageView
                        android:id="@+id/iv_sunday"
                        android:layout_width="@dimen/stop_marker_icon_size"
                        android:layout_height="@dimen/stop_marker_icon_size"
                        android:layout_gravity="center_horizontal"
                        android:layout_margin="8dp"
                        android:src="@drawable/ic_unavailable" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_checking_itinerary_existence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:orientation="vertical">

                <ProgressBar
                    android:layout_width="@dimen/stop_marker_icon_size"
                    android:layout_height="@dimen/stop_marker_icon_size"
                    android:layout_gravity="center_horizontal"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/checking_itinerary_existence"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/leave_now_text_size_sp"
                    android:layout_gravity="center_horizontal"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_itinerary_existence_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/trip_days_hint"
                android:textColor="@color/colorGrey"
                android:textSize="@dimen/content_text_size_sp" />
            <RadioButton
                android:id="@+id/rb_specific_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:textColor="@android:color/black"
                android:textSize="@dimen/address_list_view_text_size_sp"
                android:buttonTint="@color/colorValidDateBg"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_extra_large"
                android:text="@string/trip_notifications"
                android:textColor="@android:color/black"
                android:textSize="@dimen/address_input_text_size_sp"
                android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/ll_notification_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:background="@drawable/yellow_frame_rounded_yellow_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <ImageView
                    android:layout_width="@dimen/stop_marker_icon_size"
                    android:layout_height="@dimen/stop_marker_icon_size"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:src="@drawable/ic_alert_solid"
                    app:tint="@color/colorMicroMobilityRoute" />


                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notification_warning_title"
                    android:textColor="@color/colorMicroMobilityRoute"
                    android:textSize="@dimen/content_text_size"
                    android:textStyle="bold" />
            </LinearLayout>


            <TextView
                android:id="@+id/body_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/notification_warning_msg"
                android:textColor="@color/colorMicroMobilityRoute"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_notification_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_notify_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/notify_via_email"
                android:textColor="@android:color/black"
                android:textSize="@dimen/content_text_size_sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/realtime_alert_on_journey"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp" />

                <RelativeLayout
                    android:id="@+id/rl_realtime_alert"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spinner_height"
                    android:background="@drawable/grey_frame_rounded_transparent_bg">

                    <Spinner
                        android:id="@+id/sp_realtime_alert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:background="@null"
                        android:entries="@array/default_control_arrays" />

                    <ImageView
                        android:layout_width="@dimen/small_icon_size"
                        android:layout_height="@dimen/small_icon_size"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:src="@drawable/ic_down"
                        app:tint="@android:color/black" />
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/alternative_route_recommended_options"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp" />

                <RelativeLayout
                    android:id="@+id/rl_alternative_route"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spinner_height"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/grey_frame_rounded_transparent_bg">

                    <Spinner
                        android:id="@+id/sp_alternative_route"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:background="@null"
                        android:entries="@array/default_control_arrays"
                        />

                    <ImageView
                        android:layout_width="@dimen/small_icon_size"
                        android:layout_height="@dimen/small_icon_size"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:src="@drawable/ic_down"
                        app:tint="@android:color/black" />
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/delay_options"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp" />

                <RelativeLayout
                    android:id="@+id/rl_delay_options"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spinner_height"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/grey_frame_rounded_transparent_bg">

                    <Spinner
                        android:id="@+id/sp_delay_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:background="@null"
                        android:entries="@array/delay_arrays" />

                    <ImageView
                        android:layout_width="@dimen/small_icon_size"
                        android:layout_height="@dimen/small_icon_size"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:src="@drawable/ic_down"
                        app:tint="@android:color/black" />
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_advanced_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_advanced_settings"
                    android:layout_width="@dimen/small_icon_size"
                    android:layout_height="@dimen/small_icon_size"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_resume"
                    app:tint="@android:color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:text="@string/advanced_settings"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_monitor_trip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/monitor_this_trip"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/content_text_size_sp" />

                    <RelativeLayout
                        android:id="@+id/rl_monitor_trip"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/spinner_height"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/grey_frame_rounded_transparent_bg">

                        <Spinner
                            android:id="@+id/sp_monitor_trip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:background="@null"
                            android:entries="@array/monitor_trip_arrays"
                            />

                        <ImageView
                            android:layout_width="@dimen/small_icon_size"
                            android:layout_height="@dimen/small_icon_size"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/margin_medium"
                            android:src="@drawable/ic_down"
                            app:tint="@android:color/black" />
                    </RelativeLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/before_begins_ends"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_travel_companions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_extra_large"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/travel_companions"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/address_input_text_size_sp"
                    android:accessibilityHeading="true"
                    tools:targetApi="p"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/primary_traveler"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/content_text_size_sp" />
                    <TextView
                        android:id="@+id/tv_primary_traveler"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_small"
                        android:layout_gravity="center_vertical"
                        android:text="@string/myself"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/content_text_size_sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/companion_on_this_trip"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp" />

                <LinearLayout
                    android:id="@+id/ll_companion_on_this_trip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/padding_small"
                    android:paddingBottom="@dimen/padding_small"
                    android:background="@drawable/grey_frame_rounded_transparent_bg"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tv_companion_on_this_trip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_gravity="center_vertical"
                        android:hint="@string/select"
                        android:textSize="@dimen/content_text_size_sp" />

                    <ImageView
                        android:id="@+id/iv_companion_on_this_trip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_small"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_down"
                        app:tint="@color/colorGrey"
                        />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/observers_watching_this_trip"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp" />
                <LinearLayout
                    android:id="@+id/ll_observers_watching_this_trip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/padding_small"
                    android:paddingBottom="@dimen/padding_small"
                    android:background="@drawable/grey_frame_rounded_transparent_bg"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tv_observers_watching_this_trip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_gravity="center_vertical"
                        android:hint="@string/select"
                        android:textSize="@dimen/content_text_size_sp" />

                    <ImageView
                        android:id="@+id/iv_observers_watching_this_trip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_small"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_down"
                        app:tint="@color/colorGrey"
                        />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_extra_large"
                android:layout_marginBottom="@dimen/margin_medium">

                <TextView
                    android:id="@+id/tv_cancel_update_trip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/grey_frame_rounded_white_bg"
                    android:paddingStart="@dimen/padding_medium"
                    android:paddingTop="@dimen/padding_small"
                    android:paddingEnd="@dimen/padding_medium"
                    android:paddingBottom="@dimen/padding_small"
                    android:text="@string/cancel"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/content_text_size_sp" />

                <TextView
                    android:id="@+id/tv_save_trip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="170dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/rounded_primary_bg"
                    android:paddingStart="@dimen/padding_medium"
                    android:paddingTop="@dimen/padding_small"
                    android:paddingEnd="@dimen/padding_medium"
                    android:paddingBottom="@dimen/padding_small"
                    android:text="@string/save_preferences"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/content_text_size_sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    />
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
